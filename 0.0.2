    private static Map<String, Benefit__c> getBenefitsByExternalReference(BenefitPackage request, Boolean includeCore, Boolean includeOptional) {
        Set<String> requestedReferences = new Set<String>();

        if (includeCore && request.core_benefits != null) {
            for (CoreBenefit benefit : request.core_benefits) {
                requestedReferences.add(benefit.benefit_id);
            }
        }

        if (includeOptional && request.optional_benefits != null) {
            for (OptionalBenefit benefit : request.optional_benefits) {
                requestedReferences.add(benefit.benefit_id);
            }
        }

        if (requestedReferences.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'At least one benefit must be provided.');
        }

        List<Benefit__c> benefits = [
            SELECT Id, Visa_External_Reference__c, Name, Benefit_Description__c
            FROM Benefit__c
            WHERE Visa_External_Reference__c IN :requestedReferences
        ];

        Map<String, Benefit__c> result = new Map<String, Benefit__c>();

        for (Benefit__c benefit : benefits) {
            result.put(benefit.Visa_External_Reference__c, benefit);
        }

        for (String reference : requestedReferences) {
            if (!result.containsKey(reference)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + reference + ' was not found in the catalogue.');
            }
        }

        return result;
    }

    private static Product__c getProduct(String productReference) {
        List<Product__c> products = [SELECT Id FROM Product__c WHERE Key__c = :productReference LIMIT 1];
        if (products.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Product with reference ' + productReference + ' not found.');
        }
        return products[0];
    }

    private static Map<String, PricebookEntry> getPricebookEntriesByBenefitReference(Map<String, Benefit__c> benefitsByReference, String currencyIsoCode) {
        Set<Id> benefitIds = new Set<Id>();

        for (Benefit__c benefit : benefitsByReference.values()) {
            benefitIds.add(benefit.Id);
        }

        List<PricebookEntry> entries = [
            SELECT Id, Product2Id, Product2.Benefit__c, Product2.Benefit__r.Visa_External_Reference__c, Product2.Benefit__r.Name, Product2.Benefit__r.Benefit_Description__c, Pricebook2Id, UnitPrice 
            FROM PricebookEntry
            WHERE Pricebook2.Name =:BENEFITS_PRICEBOOK_NAME
                AND Pricebook2.IsActive = true
                AND Product2.Benefit__c IN :benefitIds
                AND Product2.Family = 'Benefit'
                AND Product2.IsActive = true
                AND CurrencyIsoCode = :currencyIsoCode
                AND IsActive = true
            LIMIT 200
        ];

        Map<Id, PricebookEntry> entriesByBenefitId = new Map<Id, PricebookEntry>();

        for (PricebookEntry entry : entries) {
            Id benefitId = entry.Product2.Benefit__c;
            if (entriesByBenefitId.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'More than one active PricebookEntry was found for Benefit ' + String.valueOf(benefitId) + '.');
            }
            entriesByBenefitId.put(benefitId, entry);
        }

        Map<String, PricebookEntry> result = new Map<String, PricebookEntry>();

        for (String reference : benefitsByReference.keySet()) {
            Benefit__c benefit = benefitsByReference.get(reference);
            PricebookEntry entry = entriesByBenefitId.get(benefit.Id);
            if (entry == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + reference + ' is not available for the bank currency ' + currencyIsoCode + '.');
            }
            result.put(reference, entry);
        }

        return result;
    }

    private static Id getPricebookId(Map<String, PricebookEntry> entriesByBenefit) {
        for (PricebookEntry entry :
            entriesByBenefit.values()) {
            return entry.Pricebook2Id;
        }

        throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefits pricebook is not configured.');
    }

    private static ServiceContract getBenefitPackage(String benefitPackageId) {

        WebportalApiUtility_v1.isValidSalesforceID(benefitPackageId);
        
        List<ServiceContract> packages = [
            SELECT Id, Package_Status__c, Product_Reference__c, Product__c, Pricebook2Id, 
                StartDate, EndDate, Term,
                Amount_of_Policies__c, Policy_Range_Start__c, Policy_Range_End__c,
                Legal_Consent_Code__c, Legal_Consent_Confirmed__c, Legal_Consent_Date__c,
                (
                    SELECT Id, Benefit_Category__c
                    FROM ContractLineItems
                )
            FROM ServiceContract
            WHERE Id = :benefitPackageId
            AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        if (packages.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'The searched resource was not found.');
        }

        return packages[0];
    }    

    private static List<String> getResourceSegments(String resourcePath) {
        String requestUri = RestContext.request == null ? null : RestContext.request.requestURI;

        if (String.isBlank(requestUri) || String.isBlank(resourcePath)) {
            return new List<String>();
        }

        requestUri = requestUri.split('\\?')[0];
        String suffix = requestUri.substringAfter(resourcePath);

        if (String.isBlank(suffix) ||
            suffix == '/') {
            return new List<String>();
        }

        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        String path = suffix.substring(1);
        List<String> segments = new List<String>();
        for (String segment : path.split('/')) {
            if (String.isNotBlank(segment)) {
                segments.add(segment);
            }
        }

        return segments;
    }

