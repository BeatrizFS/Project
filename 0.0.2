     //=============================VALIDAÇÕES========================================================================================

    private static void validateCreateRequest(BenefitPackage request, Date startDate, Date endDate) {
        validateDates(startDate, endDate);
        validateAmountOfPolicies(request.amount_of_policies);
        validateBenefits(request.core_benefits.size(), 'core_benefits', true);
        validateBenefits(request.optional_benefits == null ? null : request.optional_benefits.size(), 'optional_benefits', false);
    }

    private static void validateCompleteRequest(ServiceContract contract) {
        validateCompleteFields(contract);
        validateDates(contract.StartDate, contract.EndDate);
        validateCoreLineItemExists(contract.ContractLineItems);
    }

    private static void validateCompleteFields(ServiceContract contract) {
        validateRequiredField(contract.Product_Reference__c, 'product_reference');
        validateRequiredField(contract.Amount_of_Policies__c, 'amount_of_policies');
        validateRequiredField(contract.StartDate, 'active_start_at');
        validateRequiredField(contract.EndDate, 'active_end_at');
        validateRequiredField(contract.Policy_Range_Start__c, 'affected_policy_range.external_number_start_at');
        validateRequiredField(contract.Policy_Range_End__c, 'affected_policy_range.external_number_end_at');

        validateAmountOfPolicies(Integer.valueOf(contract.Amount_of_Policies__c));
    }   

    private static void validateRequiredField(Object value, String fieldName) {
        if (value == null || (value instanceof String && String.isBlank((String)value))) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', fieldName + ' is required to complete the benefit package.');
        }
    }

    private static void validatePatchRequest(BenefitPackage request, Map<String, Object> body, ServiceContract contract) {
        if (body.containsKey('active_start_at') || body.containsKey('active_end_at')) {
            Date startDate = body.containsKey('active_start_at') ? normalizeStartDate(request.active_start_at) : contract.StartDate;
            Date endDate = body.containsKey('active_end_at') ? request.active_end_at : contract.EndDate;
            validateDates(startDate, endDate);
        }
        if (body.containsKey('amount_of_policies')) {
            validateAmountOfPolicies(request.amount_of_policies);
        }
        if (body.containsKey('affected_policy_range')) {
            WebportalApiUtility_v1.runValidateRequiredFields(JSON.serialize(request.affected_policy_range), POLICY_RANGE_REQUIRED_FIELDS);
        }
        if (body.containsKey('core_benefits')) {
            validateBenefits(request.core_benefits == null ? null : request.core_benefits.size(),'core_benefits', true);
        }
        if (body.containsKey('optional_benefits')) {
            validateBenefits(request.optional_benefits == null ? null : request.optional_benefits.size(),'optional_benefits', true);
        }
    }

    private static void validateDates(Date startDate, Date endDate) {
        if (startDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_start_at is required.');
        }
        if (endDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_end_at is required.');
        }
        if (endDate <= startDate) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_end_at must be greater than active_start_at.');
        }
    }

    private static void validateAmountOfPolicies(Integer amountOfPolicies) {
        if (amountOfPolicies != null && amountOfPolicies < 1) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'amount_of_policies must be a positive integer.');
        }
    } 


    private static void validateBenefits(Integer benefitCount, String fieldName, Boolean required) {
        if (required && (benefitCount == null || benefitCount == 0)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', fieldName + ' must contain at least one benefit.');
        }

        if (benefitCount != null && benefitCount > MAX_BENEFITS) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', fieldName + ' cannot contain more than ' + MAX_BENEFITS + ' benefits.'
            );
        }
    }

    private static void validateCoreLineItemExists(List<ContractLineItem> lineItems) {
        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == CATEGORY_CORE) {
                return;
            }
        }
        throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'At least one Core benefit is required to complete the benefit package.');
    } 

    private static void validatePolicyRangePatch(BenefitPackage request) {
        if (request.affected_policy_range == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range cannot be null.');
        }

        WebportalApiUtility_v1.runValidateRequiredFields(JSON.serialize(request.affected_policy_range), POLICY_RANGE_REQUIRED_FIELDS);
    }

    private static void validateDraftStatus(ServiceContract contract, String operation) {
        if (contract.Package_Status__c != 'Draft') {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400, 'bad_request', 'Benefit package cannot be ' + operation + ' because its current status is ' + contract.Package_Status__c + '.'
            );
        }
    }

    private static Map<String, Integer> validateGetRequest(Map<String, String> requestParams) {
        Map<String, Integer> paginationParams = WebportalApiUtility_v1.validatePaginationQueryParams(requestParams, 100);
        
        if (paginationParams.get('start_index') > 2000) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'start_index cannot be greater than 2000.');
        }

        return paginationParams;
    }
