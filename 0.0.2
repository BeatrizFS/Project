private static ServiceContract buildServiceContract(
    BenefitPackage request,
    Product__c product,
    Id pricebookId,
    Date startDate,
    Date endDate
) {
    ServiceContract contract = new ServiceContract();
    contract.Name = '-';
    contract.RecordTypeId = Schema.SObjectType.ServiceContract
        .getRecordTypeInfosByDeveloperName()
        .get(BENEFIT_PACKAGE_RECORD_TYPE)
        .getRecordTypeId();
    contract.Pricebook2Id = pricebookId;
    contract.Package_Status__c = PACKAGE_STATUS.get('DRAFT');
    contract.Product_Reference__c = request.product_reference;
    contract.Product__c = product.Id;
    contract.StartDate = startDate;
    contract.EndDate = endDate;
    contract.Term = calculateWholeMonthTerm(startDate, endDate);
    contract.Amount_of_Policies__c = request.amount_of_policies;

    if (request.affected_policy_range != null) {
        contract.Policy_Range_Start__c = request.affected_policy_range.external_number_start_at;
        contract.Policy_Range_End__c = request.affected_policy_range.external_number_end_at;
    }

    populateLegalConsents(contract, request);
    return contract;
}

private static List<ContractLineItem> buildContractLineItems(
    Id contractId,
    BenefitPackage request,
    Date startDate,
    Date endDate,
    Map<String, Benefit__c> benefitsByReference,
    Map<String, PricebookEntry> pricebookEntriesByBenefit,
    Set<String> categories,
    Integer quantity
) {
    List<ContractLineItem> lineItems = new List<ContractLineItem>();

    if (categories.contains(CATEGORY_CORE)) {
        lineItems.addAll(
            buildCoreLineItems(
                contractId,
                request.core_benefits,
                startDate,
                endDate,
                benefitsByReference,
                pricebookEntriesByBenefit,
                quantity
            )
        );
    }

    if (categories.contains(CATEGORY_OPTIONAL)) {
        lineItems.addAll(
            buildOptionalLineItems(
                contractId,
                request.optional_benefits,
                startDate,
                endDate,
                benefitsByReference,
                pricebookEntriesByBenefit,
                quantity
            )
        );
    }

    return lineItems;
}

private static List<ContractLineItem> buildCoreLineItems(
    Id contractId,
    List<CoreBenefit> benefits,
    Date startDate,
    Date endDate,
    Map<String, Benefit__c> benefitsByReference,
    Map<String, PricebookEntry> pricebookEntriesByBenefit,
    Integer quantity
) {
    List<ContractLineItem> lineItems = new List<ContractLineItem>();

    if (benefits == null) {
        return lineItems;
    }

    for (CoreBenefit benefit : benefits) {
        lineItems.add(
            buildContractLineItem(
                contractId,
                quantity,
                startDate,
                endDate,
                benefitsByReference.get(benefit.benefit_id),
                pricebookEntriesByBenefit.get(benefit.benefit_id),
                CATEGORY_CORE
            )
        );
    }

    return lineItems;
}

private static List<ContractLineItem> buildOptionalLineItems(
    Id contractId,
    List<OptionalBenefit> benefits,
    Date startDate,
    Date endDate,
    Map<String, Benefit__c> benefitsByReference,
    Map<String, PricebookEntry> pricebookEntriesByBenefit,
    Integer quantity
) {
    List<ContractLineItem> lineItems = new List<ContractLineItem>();

    if (benefits == null) {
        return lineItems;
    }

    for (OptionalBenefit benefit : benefits) {
        lineItems.add(
            buildContractLineItem(
                contractId,
                quantity,
                startDate,
                endDate,
                benefitsByReference.get(benefit.benefit_id),
                pricebookEntriesByBenefit.get(benefit.benefit_id),
                CATEGORY_OPTIONAL
            )
        );
    }

    return lineItems;
}

private static ContractLineItem buildContractLineItem(
    Id contractId,
    Integer quantity,
    Date startDate,
    Date endDate,
    Benefit__c benefit,
    PricebookEntry pricebookEntry,
    String category
) {
    if (benefit == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'Benefit could not be resolved.'
        );
    }

    if (pricebookEntry == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'No PricebookEntry was found for benefit ' +
            benefit.Name +
            ' in the Visa Benefits Pricebook.'
        );
    }

    Decimal unitPrice = category == CATEGORY_CORE
        ? 0
        : pricebookEntry.UnitPrice;

    return new ContractLineItem(
        ServiceContractId = contractId,
        PricebookEntryId = pricebookEntry.Id,
        Benefit_Category__c = category,
        Quantity = quantity,
        UnitPrice = unitPrice,
        StartDate = startDate,
        EndDate = endDate
    );
}
