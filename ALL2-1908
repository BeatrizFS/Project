@RestResource(
    urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/*'
)
global with sharing class BenefitsConfigAPIPackages_VEXP {

    private static final String RESOURCE_PATH = '/benefit_packages';

    private static final String ACTION_CANCEL = 'cancel';
    private static final String ACTION_COMPLETE = 'complete';

    private static final String BENEFITS_PRICEBOOK_NAME = 'Visa Benefits';
    private static final String BENEFIT_PACKAGE_RECORD_TYPE = 'Benefit_Package';

    private static final Map<String, String> PACKAGE_STATUS = new Map<String, String>{
        'DRAFT'         => 'Draft',
        'AWAITING_START'=> 'Awaiting Start',
        'ACTIVE'        => 'Active',
        'CANCELLED'     => 'Cancelled',
        'EXPIRED'       => 'Expired'
    };

    private static final Map<String, String> CREATE_REQUIRED_FIELDS =
        new Map<String, String>{
            'product_reference' => 'Primitive',
            'active_start_at' => 'Primitive',
            'active_end_at' => 'Primitive',
            'amount_of_policies' => 'Primitive',
            'affected_policy_range' => 'Object',
            'affected_policy_range.external_number_start_at' => 'Primitive',
            'affected_policy_range.external_number_end_at' => 'Primitive',
            'core_benefits' => 'List',
            'core_benefits.benefit_id' => 'Primitive',
            'core_benefits.name' => 'Primitive',
            'legal_consents' => 'List'
        };


    // ============================================================
    // POST
    // ============================================================

    @HttpPost
    global static void doPost() {

        RestContext.response.addHeader(
            'Content-Type',
            'application/json'
        );

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleCreate();

        } else if (
            segments.size() == 2 &&
            segments[1] == ACTION_COMPLETE
        ) {
            handleComplete(segments[0]);

        } else if (
            segments.size() == 2 &&
            segments[1] == ACTION_CANCEL
        ) {
            handleCancel(segments[0]);

        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'not_found',
                'Unknown resource path'
            );
        }
    }


    // ============================================================
    // POST /benefit_packages
    // ============================================================

    private static void handleCreate() {

        try {

            validateWriteToken();

            String requestBody = RestContext.request.requestBody == null
                ? null
                : RestContext.request.requestBody.toString().trim();

            if (String.isBlank(requestBody)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Request body cannot be empty.'
                );
            }

            requestBody = WebportalApiUtility_v1.removeXMLInjections(
                requestBody
            );

            requestBody = WebportalApiUtility_v1.removeHtmlInjection(
                requestBody
            );

            BenefitPackage request =
                (BenefitPackage) JSON.deserializeStrict(
                    requestBody,
                    BenefitPackage.class
                );

            WebportalApiUtility_v1.runValidateRequiredFields(
                requestBody,
                CREATE_REQUIRED_FIELDS
            );

            validateCreateRequest(request);

            Date startDate = request.active_start_at;

            if (startDate < Date.today()) {
                startDate = Date.today();
            }

            Date endDate = request.active_end_at;

            Product__c product =
                getProduct(request.product_reference);

            Map<String, Benefit__c> benefitsByReference =
                getBenefitsByExternalReference(request);

            String currencyIsoCode = 'USD';

            Map<String, PricebookEntry> pricebookEntriesByBenefit =
                getPricebookEntriesByBenefitReference(
                    benefitsByReference,
                    currencyIsoCode
                );

            Id pricebookId =
                getPricebookId(pricebookEntriesByBenefit);

            ServiceContract contract =
                buildServiceContract(
                    request,
                    product,
                    pricebookId,
                    startDate,
                    endDate
                );

            insert contract;

            List<ContractLineItem> lineItems =
                buildContractLineItems(
                    contract.Id,
                    request,
                    startDate,
                    endDate,
                    benefitsByReference,
                    pricebookEntriesByBenefit
                );

            insert lineItems;

            BenefitPackagePostResponse response =
                new BenefitPackagePostResponse();

            response.benefit_package_id = contract.Id;

            RestContext.response.statusCode = 201;

            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(response)
                );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            setErrorResponse(ex);

        } catch (JSONException ex) {

            setGenericBadRequest();

        } catch (DMLException ex) {

            System.debug(
                LoggingLevel.ERROR,
                'DMLException: ' + ex.getMessage()
            );

            setInternalServerError(
                'Error when try to insert record in database.'
            );

        } catch (Exception ex) {

            System.debug(
                LoggingLevel.ERROR,
                'Exception type: ' + ex.getTypeName()
            );

            System.debug(
                LoggingLevel.ERROR,
                'Exception stack tracing: ' +
                ex.getStackTraceString()
            );

            setInternalServerError(
                'Unexpected error creating the request: ' +
                ex.getMessage()
            );
        }
    }


    // ============================================================
    // POST /benefit_packages/{id}/complete
    // ============================================================

    private static void handleComplete(String benefitPackageId) {

        try {

            validateWriteToken();

            ServiceContract contract =
                getBenefitPackage(benefitPackageId);

            if (
                contract.Package_Status__c !=
                PACKAGE_STATUS.get('DRAFT')
            ) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit package cannot be completed because its current status is ' +
                    contract.Package_Status__c +
                    '.'
                );
            }

            validateCompleteRequest(contract);

            contract.Package_Status__c =
                PACKAGE_STATUS.get('AWAITING_START');

            contract.Completed_At__c = System.now();

            update contract;

            RestContext.response.statusCode = 204;
            RestContext.response.responseBody = null;

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            setErrorResponse(ex);

        } catch (DMLException ex) {

            System.debug(
                LoggingLevel.ERROR,
                'DMLException: ' + ex.getMessage()
            );

            System.debug(
                LoggingLevel.ERROR,
                'DMLException stack trace: ' +
                ex.getStackTraceString()
            );

            setInternalServerError(
                'Error when try to complete benefit package.'
            );

        } catch (Exception ex) {

            System.debug(
                LoggingLevel.ERROR,
                'Exception type: ' + ex.getTypeName()
            );

            System.debug(
                LoggingLevel.ERROR,
                'Exception stack tracing: ' +
                ex.getStackTraceString()
            );

            setInternalServerError(
                'Unexpected error completing the benefit package.'
            );
        }
    }


    // ============================================================
    // POST /benefit_packages/{id}/cancel
    // ============================================================

    private static void handleCancel(String benefitPackageId) {

        try {

            validateWriteToken();

            ServiceContract contract =
                getBenefitPackage(benefitPackageId);

            Set<String> cancellableStatuses =
                new Set<String>{
                    PACKAGE_STATUS.get('DRAFT'),
                    PACKAGE_STATUS.get('AWAITING_START'),
                    PACKAGE_STATUS.get('ACTIVE')
                };

            if (
                !cancellableStatuses.contains(
                    contract.Package_Status__c
                )
            ) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit package cannot be cancelled because its current status is ' +
                    contract.Package_Status__c +
                    '.'
                );
            }

            contract.Package_Status__c =
                PACKAGE_STATUS.get('CANCELLED');

            contract.Cancelled_At__c = System.now();

            // Quando o agentContactId estiver disponível no contexto:
            // contract.Cancelled_By__c = agentContactId;

            update contract;

            RestContext.response.statusCode = 204;
            RestContext.response.responseBody = null;

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            setErrorResponse(ex);

        } catch (DMLException ex) {

            System.debug(
                LoggingLevel.ERROR,
                'DMLException: ' + ex.getMessage()
            );

            System.debug(
                LoggingLevel.ERROR,
                'DMLException stack trace: ' +
                ex.getStackTraceString()
            );

            setInternalServerError(
                'Error when try to cancel benefit package.'
            );

        } catch (Exception ex) {

            System.debug(
                LoggingLevel.ERROR,
                'Exception type: ' + ex.getTypeName()
            );

            System.debug(
                LoggingLevel.ERROR,
                'Exception stack tracing: ' +
                ex.getStackTraceString()
            );

            setInternalServerError(
                'Unexpected error cancelling the benefit package.'
            );
        }
    }


    // ============================================================
    // VALIDATIONS
    // ============================================================

    private static void validateCreateRequest(
        BenefitPackage request
    ) {

        if (
            request.active_start_at == null ||
            request.active_end_at == null
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'active_start_at and active_end_at are required.'
            );
        }

        if (
            request.active_end_at <=
            request.active_start_at
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'active_end_at must be greater than active_start_at.'
            );
        }

        if (
            request.amount_of_policies == null ||
            request.amount_of_policies < 1
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'amount_of_policies must be a positive integer.'
            );
        }

        if (
            request.core_benefits == null ||
            request.core_benefits.isEmpty()
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'core_benefits must contain at least one benefit.'
            );
        }

        if (request.core_benefits.size() > 100) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'core_benefits cannot contain more than 100 benefits.'
            );
        }

        if (
            request.optional_benefits != null &&
            request.optional_benefits.size() > 100
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'optional_benefits cannot contain more than 100 benefits.'
            );
        }

        if (
            request.legal_consents != null &&
            request.legal_consents.size() > 5
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'legal_consents cannot contain more than 5 items.'
            );
        }
    }


    private static void validateCompleteRequest(
        ServiceContract contract
    ) {

        if (String.isBlank(contract.Product_Reference__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Product_Reference__c is required to complete the benefit package.'
            );
        }

        if (
            contract.Amount_of_Policies__c == null ||
            contract.Amount_of_Policies__c < 1
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Amount_of_Policies__c must be at least 1 to complete the benefit package.'
            );
        }

        if (contract.StartDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'StartDate is required to complete the benefit package.'
            );
        }

        if (contract.EndDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'EndDate is required to complete the benefit package.'
            );
        }

        if (contract.EndDate <= contract.StartDate) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'EndDate must be greater than StartDate.'
            );
        }

        if (String.isBlank(contract.Policy_Range_Start__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Policy_Range_Start__c is required to complete the benefit package.'
            );
        }

        if (String.isBlank(contract.Policy_Range_End__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Policy_Range_End__c is required to complete the benefit package.'
            );
        }

        Boolean hasCoreBenefit = false;

        for (ContractLineItem lineItem :
             contract.ContractLineItems) {

            if (
                lineItem.Benefit_Category__c == 'Core'
            ) {
                hasCoreBenefit = true;
                break;
            }
        }

        if (!hasCoreBenefit) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'At least one Core benefit is required to complete the benefit package.'
            );
        }
    }


    // ============================================================
    // TOKEN
    // ============================================================

    private static void validateWriteToken() {

        WebportalAPITokenAuthentication_v1
            .parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );
    }


    // ============================================================
    // SERVICE CONTRACT
    // ============================================================

    private static ServiceContract getBenefitPackage(
        String benefitPackageId
    ) {

        List<ServiceContract> packages = [
            SELECT
                Id,
                Package_Status__c,
                Product_Reference__c,
                StartDate,
                EndDate,
                Amount_of_Policies__c,
                Policy_Range_Start__c,
                Policy_Range_End__c,
                Completed_At__c,
                Cancelled_At__c,
                Cancelled_By__c,
                (
                    SELECT
                        Id,
                        Benefit_Category__c
                    FROM ContractLineItems
                )
            FROM ServiceContract
            WHERE Id = :benefitPackageId
            AND RecordType.DeveloperName =
                :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        if (packages.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'Not Found',
                'The searched resource was not found.'
            );
        }

        return packages[0];
    }


    // ============================================================
    // ERROR HANDLING
    // ============================================================

    private static void setErrorResponse(
        WebportalApiUtility_v1.RequestAPIException ex
    ) {

        RestContext.response.statusCode = ex.status_code;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );
    }


    private static void setGenericBadRequest() {

        RestContext.response.statusCode = 400;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '400',
                        'Bad Request',
                        'The input information received were not compliant with the endpoint specification.'
                    )
                )
            );
    }


    private static void setInternalServerError(
        String description
    ) {

        RestContext.response.statusCode = 500;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        description
                    )
                )
            );
    }


    // ============================================================
    // RESOURCE PATH
    // ============================================================

    private static List<String> getResourceSegments(
        String resourcePath
    ) {

        String requestUri =
            RestContext.request?.requestURI;

        if (
            String.isBlank(requestUri) ||
            String.isBlank(resourcePath)
        ) {
            return new List<String>();
        }

        requestUri = requestUri.split('\\?')[0];

        String suffix =
            requestUri.substringAfter(resourcePath);

        if (
            String.isBlank(suffix) ||
            suffix == '/'
        ) {
            return new List<String>{ '' };
        }

        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        List<String> segments = new List<String>();

        String path = suffix.substring(1);

        for (String segment : path.split('/')) {
            segments.add(segment);
        }

        return segments;
    }
}
