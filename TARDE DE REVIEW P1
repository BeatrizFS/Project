    private static void validateCreateRequest(BenefitPackage request, Date startDate, Date endDate) {
        validateDates(startDate, endDate);
        validateAmountOfPolicies(request.amount_of_policies);
        validateCoreBenefits(request.core_benefits, true);
        validateOptionalBenefits(request.optional_benefits);
    }

    private static void validateOptionalBenefits(List<OptionalBenefit> benefits) {
        if (benefits != null && benefits.size() > MAX_BENEFITS) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400, 'bad_request', 'optional_benefits cannot contain more than ' + MAX_BENEFITS + ' benefits.'
            );
        }
    }

    private static void validateAmountOfPolicies(Integer amountOfPolicies) {
        if (amountOfPolicies == null || amountOfPolicies < 1) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'amount_of_policies must be a positive integer.');
        }
    }

    private static void validateCompleteRequest(ServiceContract contract) {
        if (String.isBlank(contract.Product_Reference__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Product_Reference__c is required to complete the benefit package.');
        }

        validateAmountOfPolicies(contract.Amount_of_Policies__c == null ? null : Integer.valueOf(contract.Amount_of_Policies__c));

        if (contract.StartDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'StartDate is required to complete the benefit package.');
        }

        if (contract.EndDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'EndDate is required to complete the benefit package.');
        }

        validateDates(contract.StartDate, contract.EndDate);

        if (String.isBlank(contract.Policy_Range_Start__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400, 'bad_request', 'Policy_Range_Start__c is required to complete the benefit package.'
            );
        }

        if (String.isBlank(contract.Policy_Range_End__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Policy_Range_End__c is required to complete the benefit package.');
        }

        validateCoreLineItemExists(contract.ContractLineItems);
    }


    private static void validateCoreLineItemExists(List<ContractLineItem> lineItems) {
        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == CATEGORY_CORE) {
                return;
            }
        }

        throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'At least one Core benefit is required to complete the benefit package.');
    }


    private static void applyBenefitPackagePatch(ServiceContract contract, BenefitPackage request, Map<String, Object> body) {

        //Boolean core = body.containsKey('core_benefits');
        //Boolean optional = body.containsKey('optional_benefits');        

        if (body.containsKey('product_reference')) {
            Product__c product = getProduct(request.product_reference);
            contract.Product_Reference__c = request.product_reference;
            contract.Product__c = product.Id;
        }

        if (body.containsKey('active_start_at')) {
            contract.StartDate = normalizeStartDate(request.active_start_at);
        }

        if (body.containsKey('active_end_at')) {
            contract.EndDate = request.active_end_at;
        }

        if (body.containsKey('active_start_at') || body.containsKey('active_end_at')) {
            validateDates(contract.StartDate, contract.EndDate);
            contract.Term = calculateWholeMonthTerm(contract.StartDate, contract.EndDate);
        }

        if (body.containsKey('amount_of_policies')) {
            validateAmountOfPolicies(request.amount_of_policies);
            contract.Amount_of_Policies__c = request.amount_of_policies;
            
            //syncLineItemQuantities(contract, core, optional);
        }

        if (body.containsKey('affected_policy_range')) {
            applyPolicyRangePatch(contract, request);
        }
    
        if (body.containsKey('core_benefits') ||
            body.containsKey('optional_benefits')) {
            replaceBenefitLines(contract, request, body);
        }
    }

    private static void applyPolicyRangePatch(ServiceContract contract, BenefitPackage request) {
        if (request.affected_policy_range == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range cannot be null.');
        }

        if (String.isBlank(
            request.affected_policy_range.external_number_start_at)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range.external_number_start_at is required.');
        }

        if (String.isBlank(request.affected_policy_range.external_number_end_at)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range.external_number_end_at is required.');
        }

        contract.Policy_Range_Start__c = request.affected_policy_range.external_number_start_at;

        contract.Policy_Range_End__c = request.affected_policy_range.external_number_end_at;
    }

    private static void replaceBenefitLines(ServiceContract contract, BenefitPackage request, Map<String, Object> body) {

        Boolean replaceCore = body.containsKey('core_benefits');
        Boolean replaceOptional = body.containsKey('optional_benefits');

        validateBenefitReplacementRequest(request, replaceCore, replaceOptional);

        Map<String, Benefit__c> benefitsByReference = getBenefitsByExternalReference(request, replaceCore, replaceOptional);
        Map<String, PricebookEntry> pricebookEntriesByBenefit = getPricebookEntriesByBenefitReference(benefitsByReference, CURRENCY_ISO_CODE);

        deleteReplacedBenefitLines(contract.ContractLineItems, replaceCore, replaceOptional);

        List<ContractLineItem> newLineItems = buildPatchContractLineItems(contract, request, replaceCore, replaceOptional, benefitsByReference, pricebookEntriesByBenefit);

        if (!newLineItems.isEmpty()) {
            insert newLineItems;
        }
    }

    private static void validateCoreBenefits(List<CoreBenefit> benefits, Boolean required) {
        if (required && (benefits == null || benefits.isEmpty())) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'core_benefits must contain at least one benefit.');
        }

        if (benefits != null && benefits.size() > MAX_BENEFITS) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'core_benefits cannot contain more than ' + MAX_BENEFITS + ' benefits.');
        }
    }

    private static void validateBenefitReplacementRequest(BenefitPackage request, Boolean replaceCore, Boolean replaceOptional) {
        if (replaceCore) {
            validateCoreBenefits(request.core_benefits, true);
        }

        if (replaceOptional) {
            if (request.optional_benefits == null || request.optional_benefits.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'optional_benefits must contain at least one benefit.');
            }
            validateOptionalBenefits(
                request.optional_benefits
            );
        }
    }

    private static Map<String, Benefit__c> getBenefitsByExternalReference(BenefitPackage request, Boolean includeCore, Boolean includeOptional) {
        Set<String> requestedReferences = new Set<String>();

        if (includeCore && request.core_benefits != null) {
            for (CoreBenefit benefit : request.core_benefits) {
                requestedReferences.add(benefit.benefit_id);
            }
        }

        if (includeOptional && request.optional_benefits != null) {
            for (OptionalBenefit benefit : request.optional_benefits) {
                requestedReferences.add(benefit.benefit_id);
            }
        }

        if (requestedReferences.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'At least one benefit must be provided.');
        }

        List<Benefit__c> benefits = [
            SELECT Id, Visa_External_Reference__c, Name, Benefit_Description__c
            FROM Benefit__c
            WHERE Visa_External_Reference__c IN :requestedReferences
        ];

        Map<String, Benefit__c> result = new Map<String, Benefit__c>();

        for (Benefit__c benefit : benefits) {
            result.put(benefit.Visa_External_Reference__c, benefit);
        }

        for (String reference : requestedReferences) {
            if (!result.containsKey(reference)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + reference + ' was not found in the catalogue.');
            }
        }

        return result;
    }

