@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/banks/*/agents/*')
global with sharing class WebportalSalesBanksAgents_VEXP {

    private static final Set<String> POST_REQUIRED_FIELDS = new Set<String> {
        'first_name',
        'last_name',
        'email'
    };
    
    private static final String CHANNEL_EMAIL = 'EMAIL';
    private static final String CHANNEL_PUSH_NOTIFICATION = 'PUSH_NOTIFICATION';
    private static final String RELATED_TO_BENEFIT_PACKAGE = 'BENEFIT_PACKAGES';

    @HttpPost
    global static void doPost() {
        handlePost();
    }

    @HttpGet
    global static void doGet() {
        handleGet();
    }

    @HttpPatch
    global static void doPatch() {
        handlePatch();
    }

    private static void handlePost() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.read_only',
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.write'
                }
            );

            String requestUri = RestContext.request.requestURI;
            String bankId = requestUri.substringBetween('/banks/', '/agents');

            if (String.isBlank(bankId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400,'Bad Request','The input information received were not compliant with the endpoint specification.');
            }

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            AgentData agentRequest = (AgentData)JSON.deserializeStrict(requestBody, AgentData.class);

            WebportalApiUtility_v1.validateRequestRequiredFields(requestBody, POST_REQUIRED_FIELDS);

            List<Account> bankRecords = [SELECT Id FROM Account WHERE Id = :bankId AND RecordType.DeveloperName = 'Issuer_Bank' LIMIT 1];

            if (bankRecords.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(400,'Bad Request','The input information received were not compliant with the endpoint specification.');
            }

            Account bank = bankRecords[0];

            Contact newAgent = new Contact(
                AccountId = bank.Id,
                FirstName = agentRequest.first_name,
                LastName = agentRequest.last_name,
                Email = agentRequest.email
            );
            insert newAgent;

            if(agentRequest.communication_subscriptions != null && agentRequest.communication_subscriptions.email != null && agentRequest.communication_subscriptions.email) {
                createCommunicationSubscription(bank.Id, newAgent.Id, CHANNEL_EMAIL, null);
            }

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildAgentResponse(newAgent), true));

        } catch(WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error, ex.error_description),
                        true
                    )
                );
        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400', 'Bad Request','The input information received were not compliant with the endpoint specification.')));
		} catch(DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'database_internal_server_error', 'Error when try to insert agent in database.')
                )
            );
        } catch(Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'Internal Server Error', 'Unexpected error creating the request: ' + ex.getMessage())
                )
            );
        }
    }

    private static void handleGet() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.AccessTokenData accessTokenData =
                WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                    RestContext.request,
                    new Set<String>{
                        'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.read_only'
                    }
                );

            String requestUri = RestContext.request.requestURI;
            String bankId = requestUri.substringBetween('/banks/', '/agents/');
            String agentId = requestUri.substringAfter('/agents/');

            if (String.isBlank(bankId) || String.isBlank(agentId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400,'Bad Request','The input information received were not compliant with the endpoint specification.');
            }

            List<Contact> agentRecords = [SELECT Id, FirstName, LastName, Email FROM Contact WHERE Id = :agentId AND AccountId = :bankId AND Account.RecordType.DeveloperName = 'Issuer_Bank' LIMIT 1];

            if (agentRecords.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404,'Not Found','The searched resource was not found.');
            }

            Contact agentRecord = agentRecords[0];

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildAgentResponse(agentRecord), true));

        } catch(WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statuscode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error, ex.error_description),
                        true
                    )
                );
        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('500','Internal Server Error','Unexpected error retrieving agent information.')));
        }
    }

    private static void handlePatch() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.write'
                }
            );

            String requestUri = RestContext.request.requestURI;
            String bankId = requestUri.substringBetween('/banks/', '/agents/');
            String agentId = requestUri.substringAfter('/agents/');

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            if (String.isBlank(bankId) || String.isBlank(agentId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'Bad Request', 'The input information received were not compliant with the endpoint specification.');
            }

            AgentData agentRequest = (AgentData) JSON.deserializeStrict(requestBody, AgentData.class);

            List<Contact> agentRecords = [SELECT Id, AccountId, FirstName, LastName, Email FROM Contact WHERE Id = :agentId AND AccountId = :bankId AND Account.RecordType.DeveloperName = 'Issuer_Bank' LIMIT 1];

            if (agentRecords.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'The searched resource was not found.');
            }

            Contact agent = agentRecords[0];

            if (agentRequest.communication_subscriptions != null &&
                agentRequest.communication_subscriptions.benefit_packages != null) {

                updateBenefitPackageSubscription(bankId, agent.Id, agentRequest.communication_subscriptions.benefit_packages);
            }

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildBenefitPackageSubscriptionResponse(agentRequest.communication_subscriptions.benefit_packages), true));

        } catch(WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error, ex.error_description),
                        true
                    )
                );
        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400', 'Bad Request','The input information received were not compliant with the endpoint specification.')));
        } catch(Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'Internal Server Error', 'Unexpected error creating the request: ' + ex.getMessage())
                )
            );
        }
    }

    private static Communication_Subscription__c getCommunicationSubscription(Id contactId, String channel, String relatedTo) {
        List<Communication_Subscription__c> subscriptions;
        if (channel == CHANNEL_EMAIL) {
            subscriptions = [SELECT Id, Channel__c, Related_To__c 
                FROM Communication_Subscription__c 
                WHERE Contact__c = :contactId 
                AND Channel__c = :channel LIMIT 1];
        } else {
            subscriptions = [SELECT Id, Channel__c, Related_To__c 
                FROM Communication_Subscription__c 
                WHERE Contact__c = :contactId 
                AND Channel__c = :channel 
                AND Related_To__c = :relatedTo LIMIT 1];
        }
        return subscriptions.isEmpty() ? null : subscriptions[0];
    }

    private static AgentData buildAgentResponse(Contact agent) {
        AgentData response = new AgentData();
        response.first_name = agent.FirstName;
        response.last_name = agent.LastName;
        response.email = agent.Email;

        Communication_Subscription__c emailSubscription = getCommunicationSubscription(agent.Id, CHANNEL_EMAIL, null);

        if (emailSubscription != null) {
            response.communication_subscriptions = new CommunicationSubscriptions();
            response.communication_subscriptions.email = true;
        }

        return response;
    }

    private static BenefitPackageSubscriptionResponse buildBenefitPackageSubscriptionResponse(Boolean benefitPackages) {
        BenefitPackageSubscriptionResponse response = new BenefitPackageSubscriptionResponse();
        response.communication_subscriptions = new CommunicationSubscriptions();
        response.communication_subscriptions.benefit_packages = benefitPackages;
        return response;
    }

    private static void updateBenefitPackageSubscription(Id accountId, Id contactId, Boolean isSubscribed) {
        Communication_Subscription__c subscription =
            getCommunicationSubscription(contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);

        if (isSubscribed && subscription == null) {
            createCommunicationSubscription(accountId, contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);
            return;
        }

        if (!isSubscribed && subscription != null) {
            delete subscription;
        }
    }

    private static void createCommunicationSubscription(Id accountId, Id contactId, String channel, String relatedTo) {
        Communication_Subscription__c communicationSubscription = 
            new Communication_Subscription__c(
                Customer__c = accountId,
                Contact__c = contactId,
                Channel__c = channel
        );

        if(String.isNotBlank(relatedTo)) {
            communicationSubscription.Related_To__c = relatedTo;
        }

        insert communicationSubscription;
    }

    public class AgentData {
        public String first_name {
            get {
                return first_name;
            }
            set {
                if(String.isBlank(value) || value.length() > 40) {
                    throw new WebportalApiUtility_v1.RequestAPIException(
                        400,
                        'Bad Request',
                        'Invalid request body. Out of bounds (40) or blank: first_name'
                    );
                }

                first_name = value;
            }
        }
        public String last_name {
            get {
                return last_name;
            }
            set {
                if(String.isBlank(value) || value.length() > 80) {
                    throw new WebportalApiUtility_v1.RequestAPIException(
                        400,
                        'Bad Request',
                        'Invalid request body. Out of bounds (80) or blank: last_name'
                    );
                }

                last_name = value;
            }
        }
        public String email {
            get {
                return email;
            }
            set {
                if (!WebportalApiUtility_v1.isValidEmail(value)) {
                    throw new WebportalApiUtility_v1.RequestAPIException(
                        400, 'Bad Request', 'Invalid request body. Invalid format: email'
                    );
                }

                email = value;
            }
        }
        public CommunicationSubscriptions communication_subscriptions;
    }

    public class BenefitPackageSubscriptionResponse {
        public CommunicationSubscriptions communication_subscriptions;
    }
    
    public class CommunicationSubscriptions{
        public Boolean email;
        public Boolean benefit_packages;
    }
}
