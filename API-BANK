@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/banks/*')
global with sharing class WebportalSalesBanks_VEXP {

    @HttpGet
    global static void getBanks() {
        handleGet();
    }

    private static void handleGet() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.AccessTokenData accessTokenData =
                WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                    RestContext.request,
                    new Set<String>{
                        'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.read_only'
                    }
                );

            String bankId = RestContext.request.requestURI.substringAfter('/banks/');

            if (String.isBlank(bankId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400,'Bad Request','The input information received were not compliant with the endpoint specification.');
            }

            List<Account> bankRecords = [SELECT Id, Name, Country__c, CurrencyIsoCode FROM Account WHERE Id = :bankId AND RecordType.DeveloperName = 'Issuer_Bank' LIMIT 1 ];

            if (bankRecords.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'The searched resource was not found.');
            }

            Account bankRecord = bankRecords[0];

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildBankResponse(bankRecord)));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;

            if (ex.status_code == 401) {
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('401','Unauthorized','Header "authorization" is not a valid JSON Web Token.')));
            } else if (ex.status_code == 403) {
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('403','Forbidden','The right to access this endpoint has not been granted in the JSON Web Token.')));
            } else {
                RestContext.response.responseBody = Blob.valueOf(
                    JSON.serializePretty(
                        new WebportalApiUtility_v1.ErrorMessage(
                            String.valueOf(ex.status_code),
                            ex.error,
                            ex.error_description
                        )
                    )
                );
            }
        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('500','Internal Server Error','Unexpected error retrieving bank information.')));
        }
    }

    private static BankResponse buildBankResponse(Account bank) {
        BankResponse response = new BankResponse();
        response.bank_id = bank.Id;
        response.bank_name = bank.Name;
        response.country = bank.Country__c;
        response.base_currency = bank.CurrencyIsoCode;
        return response;
    }

    public class BankResponse {
        public String bank_id;
        public String bank_name;
        public String country;
        public String base_currency;
    }
}

