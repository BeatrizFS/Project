private static void validateCompleteRequest(ServiceContract contract) {
    validateCompleteFields(contract);
    validateDates(contract.StartDate, contract.EndDate);
    validateCoreLineItemExists(contract.ContractLineItems);
}

private static void validateCompleteFields(ServiceContract contract) {
    validateRequiredField(contract.Product_Reference__c, 'product_reference');
    validateRequiredField(contract.Amount_of_Policies__c, 'amount_of_policies');
    validateRequiredField(contract.StartDate, 'active_start_at');
    validateRequiredField(contract.EndDate, 'active_end_at');
    validateRequiredField(contract.Policy_Range_Start__c, 'affected_policy_range.external_number_start_at');
    validateRequiredField(contract.Policy_Range_End__c, 'affected_policy_range.external_number_end_at');

    validateAmountOfPolicies(Integer.valueOf(contract.Amount_of_Policies__c));
}

private static void validateRequiredField(Object value, String fieldName) {
    if (value == null || (value instanceof String && String.isBlank((String)value))) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            fieldName + ' is required to complete the benefit package.'
        );
    }
}
