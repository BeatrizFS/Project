private static void validateBenefits(Integer benefitCount, String fieldName, Boolean required) {
    if (required && (benefitCount == null || benefitCount == 0)) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            fieldName + ' must contain at least one benefit.'
        );
    }

    if (benefitCount != null && benefitCount > MAX_BENEFITS) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            fieldName + ' cannot contain more than ' + MAX_BENEFITS + ' benefits.'
        );
    }
}

private static void validateBenefitReplacementRequest(
    BenefitPackage request,
    Boolean replaceCore,
    Boolean replaceOptional
) {
    if (replaceCore) {
        validateBenefits(
            request.core_benefits == null ? null : request.core_benefits.size(),
            'core_benefits',
            true
        );
    }

    if (replaceOptional) {
        validateBenefits(
            request.optional_benefits == null ? null : request.optional_benefits.size(),
            'optional_benefits',
            true
        );
    }
}
