private static void validateDates(Date startDate, Date endDate) {

    if (startDate == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_start_at is required.'
        );
    }

    if (endDate == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_end_at is required.'
        );
    }

    if (endDate <= startDate) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_end_at must be greater than active_start_at.'
        );
    }
}
