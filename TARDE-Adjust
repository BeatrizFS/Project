@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/*')
global with sharing class BenefitsConfigAPIPackages_VEXP {

    private static final String RESOURCE_PATH = '/benefit_packages';

    private static final String ACTION_CANCEL = 'cancel';
    private static final String ACTION_COMPLETE = 'complete';

    private static final String BENEFITS_PRICEBOOK_NAME = 'Visa Benefits';
    private static final String BENEFIT_PACKAGE_RECORD_TYPE = 'Benefit_Package';

    private static final String CATEGORY_CORE = 'Core';
    private static final String CATEGORY_OPTIONAL = 'Optional';
    private static final String CURRENCY_ISO_CODE = 'USD';
    private static final Integer MAX_BENEFITS = 100;

    private static final Set<String> CANCELLABLE_STATUSES = new Set<String>{'Draft', 'Awaiting Start', 'Active'};

    private static final Map<String, String> CREATE_REQUIRED_FIELDS =
        new Map<String, String>{
            'product_reference' => 'Primitive',
            'active_start_at' => 'Primitive',
            'active_end_at' => 'Primitive',
            'amount_of_policies' => 'Primitive',
            'core_benefits' => 'List',
            'core_benefits.benefit_id' => 'Primitive',
            'core_benefits.name' => 'Primitive'
        };

    private static final Map<String, String> COMPLETE_REQUIRED_FIELDS =
        new Map<String, String>{
            'amount_of_policies' => 'Primitive',
            'affected_policy_range' => 'Object',
            'affected_policy_range.external_number_start_at' => 'Primitive',
            'affected_policy_range.external_number_end_at' => 'Primitive',
            'legal_consents' => 'List'
        };
        //+CREATE_REQUIRED_FIELDS

    private static final Map<String, String> PACKAGE_STATUS = new Map<String, String>{
        'DRAFT' => 'Draft',
        'AWAITING_START' => 'Awaiting Start',
        'ACTIVE' => 'Active',
        'CANCELLED' => 'Cancelled',
        'EXPIRED' => 'Expired'
    };    

    @HttpPost
    global static void doPost() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleCreate();
        } else if (segments.size() == 2 && segments[1] == ACTION_COMPLETE) {
            handleComplete(segments[0]);
        } else if (segments.size() == 2 && segments[1] == ACTION_CANCEL) {
            handleCancel(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(404, 'not_found', 'Unknown resource path');
        }
    }

    @HttpGet
    global static void doGet() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleGet();
        } else if (segments.size() == 1) {
            handleGetDetails(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(404, 'not_found', 'Unknown resource path');
        }
    }

    @HttpPatch
    global static void doPatch() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 1) {
            handlePatch(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(404, 'not_found', 'Unknown resource path');
        }
    }

    private static void handleCreate() {

        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );

            String requestBody = RestContext.request.requestBody == null ? null : RestContext.request.requestBody.toString().trim();

            if (String.isBlank(requestBody)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Request body cannot be empty.');
            }

            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            BenefitPackage request = (BenefitPackage) JSON.deserializeStrict(requestBody, BenefitPackage.class);

            WebportalApiUtility_v1.runValidateRequiredFields(requestBody, CREATE_REQUIRED_FIELDS);

            Date startDate = normalizeStartDate(request.active_start_at);
            Date endDate = request.active_end_at;

            validateCreateRequest(request, startDate, endDate);

            Product__c product = getProduct(request.product_reference);

            //Waiting - Get in token base_currency
            String currencyIsoCode = 'USD';
            
            Map<String, Benefit__c> benefitsByReference = getBenefitsByExternalReference(request, true, true);
            Map<String, PricebookEntry> pricebookEntriesByBenefit = getPricebookEntriesByBenefitReference(benefitsByReference, currencyIsoCode);

            Id pricebookId = getPricebookId(pricebookEntriesByBenefit);

            ServiceContract contract = buildServiceContract(request, product, pricebookId, startDate, endDate);
            insert contract;

            Set<String> categories = new Set<String>{
                CATEGORY_CORE,
                CATEGORY_OPTIONAL
            };

            List<ContractLineItem> lineItems = buildContractLineItems(
                contract.Id,
                request,
                startDate,
                endDate,
                benefitsByReference,
                pricebookEntriesByBenefit,
                categories,
                request.amount_of_policies
            );
            insert lineItems;

            BenefitPackagePostResponse response = new BenefitPackagePostResponse();
            response.benefit_package_id = contract.Id;
            RestContext.response.statusCode = 201;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(response));
        
        } catch(WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error, ex.error_description),
                        true
                    )
                );
        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('400', 'Bad Request','The input information received were not compliant with the endpoint specification.')));
		} catch(DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'database_internal_server_error', 'Error when try to insert record in database.')
                )
            );
        } catch(Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'Internal Server Error', 'Unexpected error creating the request: ' + ex.getMessage())
                )
            );
        }
    }

    private static void handleComplete(String benefitPackageId) {
        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );

            String requestBody = RestContext.request.requestBody == null ? null : RestContext.request.requestBody.toString().trim();

            if (String.isBlank(requestBody)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Request body cannot be empty.');
            }

            WebportalApiUtility_v1.runValidateRequiredFields(requestBody, CREATE_REQUIRED_FIELDS);
            WebportalApiUtility_v1.runValidateRequiredFields(requestBody, COMPLETE_REQUIRED_FIELDS);

            ServiceContract contract = getBenefitPackage(benefitPackageId);

            validateDraftStatus(contract, 'completed');
            validateCompleteRequest(contract);

            contract.Package_Status__c = 'Awaiting Start';
            contract.Completed_At__c = System.now();

            update contract;

            RestContext.response.statusCode = 204;
        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(
                        new WebportalApiUtility_v1.ErrorMessage(
                            String.valueOf(ex.status_code),
                            ex.error,
                            ex.error_description
                        )
                    )
                );
        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('400', 'Bad Request','The input information received were not compliant with the endpoint specification.')));
        } catch (DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            System.debug(LoggingLevel.ERROR, 'DMLException stack trace: ' + ex.getStackTraceString());

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'database_internal_server_error', 'Error when try to complete benefit package.')
                )
            );
        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(
                        new WebportalApiUtility_v1.ErrorMessage('500', 'Internal Server Error', 'Unexpected error completing the benefit package.')
                    )
                );
        }
    }
