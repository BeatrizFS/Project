    private static Communication_Subscription__c getCommunicationSubscription(Id contactId, String channel, List<String> relatedTo) {
        List<Communication_Subscription__c> subscriptions;

        if (channel == CHANNEL_EMAIL) {
            subscriptions = [
                SELECT Id, Channel__c, Related_To__c
                FROM Communication_Subscription__c
                WHERE Contact__c = :contactId
                AND Channel__c = :channel
                LIMIT 1
            ];
        } else {
            subscriptions = [
                SELECT Id, Channel__c, Related_To__c
                FROM Communication_Subscription__c
                WHERE Contact__c = :contactId
                AND Channel__c = :channel
                AND Related_To__c IN :relatedTo
                LIMIT 1
            ];
        }

        return subscriptions.isEmpty() ? null : subscriptions[0];
    }


    private static void updateBenefitPackageSubscription(Id accountId, Id contactId, Boolean isSubscribed) {

        Communication_Subscription__c subscription = getCommunicationSubscription(contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);

        if (isSubscribed && subscription == null) {
            createCommunicationSubscription(
                accountId,
                contactId,
                CHANNEL_PUSH_NOTIFICATION,
                RELATED_TO_BENEFIT_PACKAGE
            );
            return;
        }

        if (!isSubscribed && subscription != null) {
            delete subscription;
        }
    }

    private static void createCommunicationSubscription(Id accountId, Id contactId, String channel, List<String> relatedTo) {
        Communication_Subscription__c communicationSubscription =
            new Communication_Subscription__c(
                Customer__c = accountId,
                Contact__c = contactId,
                Channel__c = channel
            );

        if (relatedTo != null && !relatedTo.isEmpty()) {
            communicationSubscription.Related_To__c = relatedTo[0];
        }

        insert communicationSubscription;
    }

    private static BankResponse buildBankResponse(Account bank) {
        BankResponse response = new BankResponse();
        response.bank_id = bank.Id;
        response.bank_name = bank.Name;
        response.country = bank.Country__c;
        response.base_currency = bank.CurrencyIsoCode;
        return response;
    }


    private static AgentData buildAgentResponse(Contact agent) {
        AgentData response = new AgentData();
        response.first_name = agent.FirstName;
        response.last_name = agent.LastName;
        response.email = agent.Email;


        Communication_Subscription__c emailSubscription = getCommunicationSubscription(agent.Id, CHANNEL_EMAIL, null);

        if (emailSubscription != null) {
            response.communication_subscriptions = new CommunicationSubscriptions();
            response.communication_subscriptions.email = true;
        }

        return response;
    }

    private static BenefitPackageSubscriptionResponse buildBenefitPackageSubscriptionResponse(Boolean benefitPackages) {
        BenefitPackageSubscriptionResponse response = new BenefitPackageSubscriptionResponse();
        response.communication_subscriptions = new CommunicationSubscriptions();
        response.communication_subscriptions.benefit_packages = benefitPackages;
        return response;
    }

    private static List<String> getResourceSegments(String resourcePath) {
        String requestUri = RestContext.request?.requestURI;

        if (String.isBlank(requestUri) || String.isBlank(resourcePath)) {
            return new List<String>();
        }

        requestUri = requestUri.split('\\?')[0];
        String suffix = requestUri.substringAfter(resourcePath);

        if (String.isBlank(suffix) || suffix == '/') {
            return new List<String>();
        }

        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        List<String> segments = new List<String>();

        for (String segment : suffix.split('/')) {
            if (String.isNotBlank(segment)) {
                segments.add(segment);
            }
        }

        return segments;
    }

