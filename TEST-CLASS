private static void replaceBenefitLines(ServiceContract contract, BenefitPackage request, Map<String, Object> body) {
    Boolean replaceCore = body.containsKey('core_benefits');
    Boolean replaceOptional = body.containsKey('optional_benefits');

    if (!replaceCore && !replaceOptional) {
        return;
    }

    Map<String, Benefit__c> benefitsByReference =
        getBenefitsByExternalReference(request, replaceCore, replaceOptional);

    Map<String, PricebookEntry> pricebookEntriesByBenefit =
        getPricebookEntriesByBenefitReference(benefitsByReference, 'USD');

    deleteReplacedBenefitLines(contract.ContractLineItems, replaceCore, replaceOptional);

    Set<String> categories = new Set<String>();

    if (replaceCore) {
        categories.add(CATEGORY_CORE);
    }

    if (replaceOptional) {
        categories.add(CATEGORY_OPTIONAL);
    }

    Integer quantity = contract.Amount_of_Policies__c == null
        ? 0
        : Integer.valueOf(contract.Amount_of_Policies__c);

    List<ContractLineItem> newLineItems = buildContractLineItems(
        contract.Id,
        request,
        contract.StartDate,
        contract.EndDate,
        benefitsByReference,
        pricebookEntriesByBenefit,
        categories,
        quantity
    );

    if (!newLineItems.isEmpty()) {
        insert newLineItems;
    }
}

