// ============================================================

private static Map<String, Object> buildUpdateBenefitPackageBody() {
    return new Map<String, Object>{
        'product_reference' => 'I_C_BR',

        'active_start_at' => '2026-10-01',

        'active_end_at' => '2027-10-01',

        'amount_of_policies' => 200,

        'affected_policy_range' =>
            new Map<String, Object>{
                'external_number_start_at' => '2000',
                'external_number_end_at' => '2200'
            },

        'core_benefits' =>
            new List<Object>{
                new Map<String, Object>{
                    'benefit_id' => 'LACIEMS',
                    'name' =>
                        '(EMC) Emergency Medical Assistance'
                }
            },

        'optional_benefits' =>
            new List<Object>{
                new Map<String, Object>{
                    'benefit_id' => 'LACCELPRO',
                    'name' =>
                        'Cellphone Protection'
                }
            }
    };
}


private static void executePatch(
    Id benefitPackageId,
    Map<String, Object> body
) {
    executePatch(
        benefitPackageId,
        body,
        true
    );
}


private static void executePatch(
    Id benefitPackageId,
    Map<String, Object> body,
    Boolean authenticated
) {
    String rawBody =
        body == null
            ? ''
            : JSON.serialize(body);

    executePatchWithRawBody(
        benefitPackageId,
        rawBody,
        authenticated
    );
}


private static void executePatchWithRawBody(
    Id benefitPackageId,
    String rawBody
) {
    executePatchWithRawBody(
        benefitPackageId,
        rawBody,
        true
    );
}


private static void executePatchWithRawBody(
    Id benefitPackageId,
    String rawBody,
    Boolean authenticated
) {
    RestRequest req = new RestRequest();
    RestResponse res = new RestResponse();

    req.requestURI =
        BASE_URI + '/' + benefitPackageId;

    req.httpMethod =
        'PATCH';

    if (authenticated) {
        req.headers.put(
            'authorization2',
            'Bearer ' + token
        );
    }

    if (rawBody != null) {
        req.requestBody =
            Blob.valueOf(rawBody);
    }

    RestContext.request = req;
    RestContext.response = res;

    Test.startTest();
    BenefitsConfigAPIPackages_VEXP.doPatch();
    Test.stopTest();
}


private static void assertSuccessfulPatch() {
    System.assertEquals(
        204,
        RestContext.response.statusCode,
        'PATCH should return HTTP 204.'
    );

    System.assertEquals(
        null,
        RestContext.response.responseBody,
        'PATCH 204 should not return a response body.'
    );
}


private static void assertUpdatedBenefitPackage(
    ServiceContract contract
) {
    System.assertEquals(
        'Draft',
        contract.Package_Status__c
    );

    System.assertEquals(
        'I_C_BR',
        contract.Product_Reference__c
    );

    System.assertNotEquals(
        null,
        contract.Product__c
    );

    System.assertEquals(
        Date.newInstance(2026, 10, 1),
        contract.StartDate
    );

    System.assertEquals(
        Date.newInstance(2027, 10, 1),
        contract.EndDate
    );

    System.assertEquals(
        12,
        contract.Term
    );

    System.assertEquals(
        200,
        Integer.valueOf(
            contract.Amount_of_Policies__c
        )
    );

    System.assertEquals(
        '2000',
        contract.Policy_Range_Start__c
    );

    System.assertEquals(
        '2200',
        contract.Policy_Range_End__c
    );
}


private static void assertUpdatedBenefitLines(
    List<ContractLineItem> lineItems
) {
    System.assertEquals(
        2,
        lineItems.size()
    );

    System.assertEquals(
        'Core',
        lineItems[0].Benefit_Category__c
    );

    System.assertEquals(
        200,
        Integer.valueOf(
            lineItems[0].Quantity
        )
    );

    System.assertEquals(
        0,
        lineItems[0].UnitPrice
    );

    System.assertEquals(
        'LACIEMS',
        lineItems[0]
            .PricebookEntry
            .Product2
            .Benefit__r
            .Visa_External_Reference__c
    );

    System.assertEquals(
        'Optional',
        lineItems[1].Benefit_Category__c
    );

    System.assertEquals(
        200,
        Integer.valueOf(
            lineItems[1].Quantity
        )
    );

    System.assertEquals(
        50,
        lineItems[1].UnitPrice
    );

    System.assertEquals(
        'LACCELPRO',
        lineItems[1]
            .PricebookEntry
            .Product2
            .Benefit__r
            .Visa_External_Reference__c
    );
}


private static List<ContractLineItem> getBenefitPackageLineItems(
    Id benefitPackageId
) {
    return [
        SELECT Benefit_Category__c,
               Quantity,
               UnitPrice,
               StartDate,
               EndDate,
               PricebookEntry.Product2.Benefit__r
                   .Visa_External_Reference__c
        FROM ContractLineItem
        WHERE ServiceContractId = :benefitPackageId
        ORDER BY Benefit_Category__c
    ];
}
