private static Map<String, Object> buildUpdateBenefitPackageBody() {
    return new Map<String, Object>{
        'product_reference' => 'I_C_BR',
        'active_start_at' => '2026-10-01',
        'active_end_at' => '2027-10-01',
        'amount_of_policies' => 200,
        'affected_policy_range' => new Map<String, Object>{
            'external_number_start_at' => '2000',
            'external_number_end_at' => '2200'
        },
        'core_benefits' => new List<Object>{
            new Map<String, Object>{
                'benefit_id' => 'LACIEMS',
                'name' => '(EMC) Emergency Medical Assistance'
            }
        },
        'optional_benefits' => new List<Object>{
            new Map<String, Object>{
                'benefit_id' => 'LACCELPRO',
                'name' => 'Cellphone Protection'
            }
        }
    };
}

private static void executePatch(Id benefitPackageId, Map<String, Object> body) {
    executePatch(benefitPackageId, body, true);
}

private static void executePatch(Id benefitPackageId, Map<String, Object> body, Boolean authenticated) {
    RestRequest req = new RestRequest();
    RestResponse res = new RestResponse();

    req.requestURI = BASE_URI + '/' + benefitPackageId;
    req.httpMethod = 'PATCH';

    if (authenticated) {
        req.headers.put('authorization2', 'Bearer ' + token);
    }

    if (body != null) {
        req.requestBody = Blob.valueOf(JSON.serialize(body));
    }

    RestContext.request = req;
    RestContext.response = res;

    Test.startTest();
    BenefitsConfigAPIPackages_VEXP.doPatch();
    Test.stopTest();
}

private static void executePatchWithRawBody(Id benefitPackageId, String rawBody) {
    RestRequest req = new RestRequest();
    RestResponse res = new RestResponse();

    req.requestURI = BASE_URI + '/' + benefitPackageId;
    req.httpMethod = 'PATCH';
    req.headers.put('authorization2', 'Bearer ' + token);

    if (rawBody != null) {
        req.requestBody = Blob.valueOf(rawBody);
    }

    RestContext.request = req;
    RestContext.response = res;

    Test.startTest();
    BenefitsConfigAPIPackages_VEXP.doPatch();
    Test.stopTest();
}

private static List<ContractLineItem> getBenefitPackageLineItems(Id benefitPackageId) {
    return [
        SELECT Benefit_Category__c, Quantity, UnitPrice, StartDate, EndDate,
               PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c
        FROM ContractLineItem
        WHERE ServiceContractId = :benefitPackageId
        ORDER BY Benefit_Category__c
    ];
}
