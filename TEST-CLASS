    @isTest
    static void updateBenefitPackage() {
        ServiceContract contract = [
            SELECT Id,
                Package_Status__c,
                Product_Reference__c,
                StartDate,
                EndDate,
                Amount_of_Policies__c,
                Policy_Range_Start__c,
                Policy_Range_End__c
            FROM ServiceContract
            WHERE RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        Map<String, Object> body = new Map<String, Object>{
            'product_reference' => 'I_C_BR',
            'active_start_at' => '2026-10-01',
            'active_end_at' => '2027-10-01',
            'amount_of_policies' => 200,
            'affected_policy_range' => new Map<String, Object>{
                'external_number_start_at' => '2000',
                'external_number_end_at' => '2200'
            },
            'core_benefits' => new List<Object>{
                new Map<String, Object>{
                    'benefit_id' => 'LACIEMS',
                    'name' => '(EMC) Emergency Medical Assistance'
                }
            },
            'optional_benefits' => new List<Object>{
                new Map<String, Object>{
                    'benefit_id' => 'LACCELPRO',
                    'name' => 'Cellphone Protection'
                }
            }
        };

        RestRequest req = new RestRequest();
        RestResponse res = new RestResponse();

        req.requestURI = BASE_URI + '/' + contract.Id;
        req.httpMethod = 'PATCH';
        req.headers.put('authorization2', 'Bearer ' + token);
        req.requestBody = Blob.valueOf(JSON.serialize(body));

        RestContext.request = req;
        RestContext.response = res;

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doPatch();
        Test.stopTest();

        System.assertEquals(204, RestContext.response.statusCode);
        System.assertEquals(null, RestContext.response.responseBody);

        ServiceContract updatedContract = [
            SELECT Package_Status__c,
                Product_Reference__c,
                Product__c,
                StartDate,
                EndDate,
                Term,
                Amount_of_Policies__c,
                Policy_Range_Start__c,
                Policy_Range_End__c
            FROM ServiceContract
            WHERE Id = :contract.Id
        ];

        System.assertEquals('Draft', updatedContract.Package_Status__c);
        System.assertEquals('I_C_BR', updatedContract.Product_Reference__c);
        System.assertNotEquals(null, updatedContract.Product__c);
        System.assertEquals(Date.newInstance(2026, 10, 1), updatedContract.StartDate);
        System.assertEquals(Date.newInstance(2027, 10, 1), updatedContract.EndDate);
        System.assertEquals(12, updatedContract.Term);
        System.assertEquals(200, Integer.valueOf(updatedContract.Amount_of_Policies__c));
        System.assertEquals('2000', updatedContract.Policy_Range_Start__c);
        System.assertEquals('2200', updatedContract.Policy_Range_End__c);

        List<ContractLineItem> lineItems = [
            SELECT Id,
                Benefit_Category__c,
                Quantity,
                UnitPrice,
                StartDate,
                EndDate,
                PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c
            FROM ContractLineItem
            WHERE ServiceContractId = :contract.Id
            ORDER BY Benefit_Category__c
        ];

        System.assertEquals(2, lineItems.size());

        System.assertEquals('Core', lineItems[0].Benefit_Category__c);
        System.assertEquals(200, Integer.valueOf(lineItems[0].Quantity));
        System.assertEquals(0, lineItems[0].UnitPrice);
        System.assertEquals(
            'LACIEMS',
            lineItems[0].PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c
        );
        System.assertEquals(Date.newInstance(2026, 10, 1), lineItems[0].StartDate);
        System.assertEquals(Date.newInstance(2027, 10, 1), lineItems[0].EndDate);

        System.assertEquals('Optional', lineItems[1].Benefit_Category__c);
        System.assertEquals(200, Integer.valueOf(lineItems[1].Quantity));
        System.assertEquals(50, lineItems[1].UnitPrice);
        System.assertEquals(
            'LACCELPRO',
            lineItems[1].PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c
        );
    }

