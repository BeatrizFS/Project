// ============================================================
// PATCH - UPDATE
// ============================================================

@isTest
static void updateBenefitPackage() {
    ServiceContract contract = getBenefitPackage();

    Map<String, Object> body =
        buildUpdateBenefitPackageBody();

    executePatch(
        contract.Id,
        body
    );

    assertSuccessfulPatch();

    ServiceContract updatedContract =
        getBenefitPackage();

    assertUpdatedBenefitPackage(
        updatedContract
    );

    List<ContractLineItem> lineItems =
        getBenefitPackageLineItems(
            contract.Id
        );

    assertUpdatedBenefitLines(
        lineItems
    );
}


