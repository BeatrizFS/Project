// ============================================================
// PATCH - UPDATE
// ============================================================

@isTest
static void updateBenefitPackage() {
    ServiceContract contract = getBenefitPackage();

    Map<String, Object> body = buildUpdateBenefitPackageBody();

    executePatch(contract.Id, body);

    System.assertEquals(204, RestContext.response.statusCode);
    System.assertEquals(null, RestContext.response.responseBody);

    ServiceContract updatedContract = getBenefitPackage();

    System.assertEquals('Draft', updatedContract.Package_Status__c);
    System.assertEquals('I_C_BR', updatedContract.Product_Reference__c);
    System.assertNotEquals(null, updatedContract.Product__c);
    System.assertEquals(Date.newInstance(2026, 10, 1), updatedContract.StartDate);
    System.assertEquals(Date.newInstance(2027, 10, 1), updatedContract.EndDate);
    System.assertEquals(12, updatedContract.Term);
    System.assertEquals(200, Integer.valueOf(updatedContract.Amount_of_Policies__c));
    System.assertEquals('2000', updatedContract.Policy_Range_Start__c);
    System.assertEquals('2200', updatedContract.Policy_Range_End__c);

    List<ContractLineItem> lineItems = getBenefitPackageLineItems(contract.Id);

    System.assertEquals(2, lineItems.size());

    System.assertEquals('Core', lineItems[0].Benefit_Category__c);
    System.assertEquals(200, Integer.valueOf(lineItems[0].Quantity));
    System.assertEquals(0, lineItems[0].UnitPrice);
    System.assertEquals('LACIEMS', lineItems[0].PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c);
    System.assertEquals(Date.newInstance(2026, 10, 1), lineItems[0].StartDate);
    System.assertEquals(Date.newInstance(2027, 10, 1), lineItems[0].EndDate);

    System.assertEquals('Optional', lineItems[1].Benefit_Category__c);
    System.assertEquals(200, Integer.valueOf(lineItems[1].Quantity));
    System.assertEquals(50, lineItems[1].UnitPrice);
    System.assertEquals('LACCELPRO', lineItems[1].PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c);
    System.assertEquals(Date.newInstance(2026, 10, 1), lineItems[1].StartDate);
    System.assertEquals(Date.newInstance(2027, 10, 1), lineItems[1].EndDate);
}


