    @isTest
    static void createBenefitPackage() {
        RestRequest req = new RestRequest();
        RestResponse res = new RestResponse();

        req.requestURI = BASE_URI;
        req.httpMethod = 'POST';
        req.headers.put('authorization2', 'Bearer ' + token);
        req.requestBody = Blob.valueOf(requestBody);

        RestContext.request = req;
        RestContext.response = res;

        Test.starttest();
        BenefitsConfigAPIPackages_VEXP.doPost();
        Test.stoptest();

        System.assertEquals(201, RestContext.response.statuscode);

        BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse)
            JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse.class
            );

        System.assertNotEquals(null, response.benefit_package_id);

        ServiceContract contract = [
            SELECT Id, Package_Status__c, Product_Reference__c,
                   Product__c, StartDate, EndDate, Term,
                   Amount_of_Policies__c, Policy_Range_Start__c,
                   Policy_Range_End__c, Legal_Consent_Code__c,
                   Legal_Consent_Confirmed__c, Legal_Consent_Date__c,
                   Pricebook2Id
            FROM ServiceContract
            WHERE Id = :response.benefit_package_id
        ];

        System.assertEquals('Draft', contract.Package_Status__c);
        System.assertEquals('I_C_BR', contract.Product_Reference__c);
        System.assertEquals(Date.newInstance(2026, 9, 1), contract.StartDate);
        System.assertEquals(Date.newInstance(2027, 9, 1), contract.EndDate);
        System.assertEquals(12, contract.Term);
        System.assertEquals(100, Integer.valueOf(contract.Amount_of_Policies__c));
        System.assertEquals('1000', contract.Policy_Range_Start__c);
        System.assertEquals('1100', contract.Policy_Range_End__c);
        
        System.assertEquals('legal_consent_I_understand', contract.Legal_Consent_Code__c);
        System.assertEquals(true, contract.Legal_Consent_Confirmed__c);
        System.assertNotEquals(null, contract.Legal_Consent_Date__c);

        System.assertNotEquals(null, contract.Product__c);
        System.assertNotEquals(null, contract.Pricebook2Id);

        List<ContractLineItem> lineItems = [SELECT Benefit_Category__c, Quantity, UnitPrice FROM ContractLineItem WHERE ServiceContractId = :contract.Id ORDER BY Benefit_Category__c];

        System.assertEquals(2, lineItems.size());
        System.assertEquals('Core', lineItems[0].Benefit_Category__c);
        System.assertEquals(0, lineItems[0].UnitPrice);
        System.assertEquals(100, Integer.valueOf(lineItems[0].Quantity));
        System.assertEquals('Optional', lineItems[1].Benefit_Category__c);
        System.assertEquals(50, lineItems[1].UnitPrice);
        System.assertEquals(100, Integer.valueOf(lineItems[1].Quantity));
    }

