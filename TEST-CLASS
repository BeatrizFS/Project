@isTest
static void updateBenefitPackageWithoutOptionalBenefits() {
    ServiceContract contract = getBenefitPackage();

    Map<String, Object> body = buildUpdateBenefitPackageBody();
    body.remove('optional_benefits');

    executePatch(contract.Id, body);

    System.assertEquals(204, RestContext.response.statusCode);

    List<ContractLineItem> lineItems = getBenefitPackageLineItems(contract.Id);

    System.assertEquals(2, lineItems.size());
    System.assertEquals('Core', lineItems[0].Benefit_Category__c);
    System.assertEquals('Optional', lineItems[1].Benefit_Category__c);
}

@isTest
static void updateBenefitPackageWithEmptyOptionalBenefits() {
    ServiceContract contract = getBenefitPackage();

    Map<String, Object> body = buildUpdateBenefitPackageBody();
    body.put('optional_benefits', new List<Object>());

    executePatch(contract.Id, body);

    System.assertEquals(400, RestContext.response.statusCode);

    WebportalApiUtility_v1.ErrorMessage response =
        (WebportalApiUtility_v1.ErrorMessage) JSON.deserialize(
            RestContext.response.responseBody.toString(),
            WebportalApiUtility_v1.ErrorMessage.class
        );

    System.assertEquals('400', response.status_code);
}

