@RestResource(
    urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/*'
)
global with sharing class BenefitsConfigAPIPackages_VEXP {

    private static final String RESOURCE_PATH = '/benefit_packages';

    private static final String ACTION_CANCEL = 'cancel';
    private static final String ACTION_COMPLETE = 'complete';

    private static final String BENEFITS_PRICEBOOK_NAME = 'Visa Benefits';
    private static final String BENEFIT_PACKAGE_RECORD_TYPE = 'Benefit_Package';

    private static final String STATUS_DRAFT = 'Draft';
    private static final String STATUS_AWAITING_START = 'Awaiting Start';
    private static final String STATUS_ACTIVE = 'Active';
    private static final String STATUS_CANCELLED = 'Cancelled';
    private static final String STATUS_EXPIRED = 'Expired';

    private static final String CATEGORY_CORE = 'Core';
    private static final String CATEGORY_OPTIONAL = 'Optional';

    private static final String CURRENCY_ISO_CODE = 'USD';

    private static final Integer MAX_BENEFITS = 100;
    private static final Integer MAX_LEGAL_CONSENTS = 5;
    private static final Integer MAX_PAGINATION_RESULTS = 100;
    private static final Integer MAX_OFFSET = 2000;

    private static final Set<String> CANCELLABLE_STATUSES = new Set<String>{
        STATUS_DRAFT,
        STATUS_AWAITING_START,
        STATUS_ACTIVE
    };

    private static final Map<String, String> CREATE_REQUIRED_FIELDS = new Map<String, String>{
        'product_reference' => 'Primitive',
        'active_start_at' => 'Primitive',
        'active_end_at' => 'Primitive',
        'amount_of_policies' => 'Primitive',
        'core_benefits' => 'List',
        'core_benefits.benefit_id' => 'Primitive',
        'core_benefits.name' => 'Primitive'
    };

    private static final Map<String, String> COMPLETE_REQUIRED_FIELDS = new Map<String, String>{
        'amount_of_policies' => 'Primitive',
        'affected_policy_range' => 'Object',
        'affected_policy_range.external_number_start_at' => 'Primitive',
        'affected_policy_range.external_number_end_at' => 'Primitive',
        'legal_consents' => 'List'
    };

    private static final Map<String, String> PACKAGE_STATUS = new Map<String, String>{
        'DRAFT' => STATUS_DRAFT,
        'AWAITING_START' => STATUS_AWAITING_START,
        'ACTIVE' => STATUS_ACTIVE,
        'CANCELLED' => STATUS_CANCELLED,
        'EXPIRED' => STATUS_EXPIRED
    };

    @HttpPost
    global static void doPost() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleCreate();
        } else if (segments.size() == 2 && segments[1] == ACTION_COMPLETE) {
            handleComplete(segments[0]);
        } else if (segments.size() == 2 && segments[1] == ACTION_CANCEL) {
            handleCancel(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'not_found',
                'Unknown resource path'
            );
        }
    }

    @HttpGet
    global static void doGet() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleGet();
        } else if (segments.size() == 1) {
            handleGetDetails(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'not_found',
                'Unknown resource path'
            );
        }
    }

    @HttpPatch
    global static void doPatch() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 1) {
            handlePatch(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'not_found',
                'Unknown resource path'
            );
        }
    }

    private static void handleCreate() {
        try {
            validateWriteToken();

            String requestBody = getRequestBody();

            BenefitPackage request =
                (BenefitPackage) JSON.deserializeStrict(
                    requestBody,
                    BenefitPackage.class
                );

            WebportalApiUtility_v1.runValidateRequiredFields(
                requestBody,
                CREATE_REQUIRED_FIELDS
            );

            // FIX #1: normaliza a data de início ANTES de validar,
            // para que a validação de start < end considere o valor
            // que efetivamente será persistido no contrato.
            Date startDate = normalizeStartDate(request.active_start_at);
            Date endDate = request.active_end_at;

            validateCreateRequest(request, startDate, endDate);

            Product__c product = getProduct(request.product_reference);

            Map<String, Benefit__c> benefitsByReference =
                getBenefitsByExternalReference(request);

            Map<String, PricebookEntry> pricebookEntriesByBenefit =
                getPricebookEntriesByBenefitReference(
                    benefitsByReference,
                    CURRENCY_ISO_CODE
                );

            Id pricebookId = getPricebookId(pricebookEntriesByBenefit);

            ServiceContract contract =
                buildServiceContract(
                    request,
                    product,
                    pricebookId,
                    startDate,
                    endDate
                );

            insert contract;

            List<ContractLineItem> lineItems =
                buildContractLineItems(
                    contract.Id,
                    request,
                    startDate,
                    endDate,
                    benefitsByReference,
                    pricebookEntriesByBenefit
                );

            insert lineItems;

            BenefitPackagePostResponse response =
                new BenefitPackagePostResponse();

            response.benefit_package_id = contract.Id;

            RestContext.response.statusCode = 201;
            RestContext.response.responseBody =
                Blob.valueOf(JSON.serializePretty(response));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            writeErrorResponse(ex);

        } catch (JSONException ex) {
            writeErrorResponse(
                400,
                'Bad Request',
                'The input information received were not compliant with the endpoint specification.'
            );

        } catch (DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());

            writeErrorResponse(
                500,
                'database_internal_server_error',
                'Error when try to insert record in database.'
            );

        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error creating the request: ' + ex.getMessage()
            );
        }
    }

