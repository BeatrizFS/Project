    private static Integer calculateWholeMonthTerm(
        Date startDate,
        Date endDate
    ) {
        Integer months =
            (
                (endDate.year() - startDate.year())
                * 12
            )
            +
            (
                endDate.month()
                - startDate.month()
            );

        if (endDate.day() < startDate.day()) {
            months--;
        }

        return months < 1
            ? 1
            : months;
    }

