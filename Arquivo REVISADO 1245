    private static List<LegalConsentItem> buildLegalConsentResponse(
        ServiceContract contract
    ) {
        List<LegalConsentItem> legalConsents =
            new List<LegalConsentItem>();

        if (
            String.isBlank(
                contract.Legal_Consent_Code__c
            )
        ) {
            return legalConsents;
        }

        LegalConsentItem consent =
            new LegalConsentItem();

        consent.code =
            contract.Legal_Consent_Code__c;

        consent.is_confirmed =
            contract.Legal_Consent_Confirmed__c;

        consent.consented_at =
            contract.Legal_Consent_Date__c == null
                ? null
                : contract.Legal_Consent_Date__c
                    .formatGmt(
                        'yyyy-MM-dd\'T\'HH:mm:ss\'Z\''
                    );

        legalConsents.add(consent);

        return legalConsents;
    }

    private static void populateLegalConsents(
        ServiceContract contract,
        BenefitPackage request
    ) {
        if (
            request.legal_consents == null ||
            request.legal_consents.isEmpty()
        ) {
            return;
        }

        LegalConsentItem consent =
            request.legal_consents[0];

        contract =
            (ServiceContract)
            WebportalApiUtility_v1.setSObjectField(
                contract,
                'Legal_Consent_Code__c',
                consent.code,
                false
            );

        contract =
            (ServiceContract)
            WebportalApiUtility_v1.setSObjectField(
                contract,
                'Legal_Consent_Confirmed__c',
                consent.is_confirmed != null
                    ? consent.is_confirmed
                    : false
            );

        if (
            String.isNotBlank(
                consent.consented_at
            )
        ) {
            String value =
                consent.consented_at;

            if (value.endsWith('Z')) {
                value =
                    value.substring(
                        0,
                        value.length() - 1
                    );
            }

            value =
                value.replace(
                    'T',
                    ' '
                );

            Datetime consentedAt =
                Datetime.valueOfGmt(value);

            contract =
                (ServiceContract)
                WebportalApiUtility_v1.setSObjectField(
                    contract,
                    'Legal_Consent_Date__c',
                    consentedAt,
                    false
                );
        }
    }

