    private static Map<String, PricebookEntry> getPricebookEntriesByBenefitReference(
        Map<String, Benefit__c> benefitsByReference,
        String currencyIsoCode
    ) {
        Set<Id> benefitIds =
            new Set<Id>();

        for (Benefit__c benefit :
            benefitsByReference.values()
        ) {
            benefitIds.add(benefit.Id);
        }

        List<PricebookEntry> entries = [
            SELECT
                Id,
                Product2Id,
                Product2.Benefit__c,
                Product2.Benefit__r.Visa_External_Reference__c,
                Product2.Benefit__r.Name,
                Product2.Benefit__r.Benefit_Description__c,
                Pricebook2Id,
                UnitPrice
            FROM PricebookEntry
            WHERE Pricebook2.Name = :BENEFITS_PRICEBOOK_NAME
            AND Pricebook2.IsActive = true
            AND Product2.Benefit__c IN :benefitIds
            AND Product2.Family = 'Benefit'
            AND Product2.IsActive = true
            AND CurrencyIsoCode = :currencyIsoCode
            AND IsActive = true
            LIMIT 200
        ];

        Map<Id, PricebookEntry> entriesByBenefitId =
            new Map<Id, PricebookEntry>();

        for (PricebookEntry entry : entries) {
            Id benefitId =
                entry.Product2.Benefit__c;

            if (entriesByBenefitId.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'More than one active PricebookEntry was found for Benefit '
                    + String.valueOf(benefitId)
                    + '.'
                );
            }

            entriesByBenefitId.put(
                benefitId,
                entry
            );
        }

        Map<String, PricebookEntry> result =
            new Map<String, PricebookEntry>();

        for (String reference :
            benefitsByReference.keySet()
        ) {
            Benefit__c benefit =
                benefitsByReference.get(reference);

            PricebookEntry entry =
                entriesByBenefitId.get(
                    benefit.Id
                );

            if (entry == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit '
                    + reference
                    + ' is not available for the bank currency '
                    + currencyIsoCode
                    + '.'
                );
            }

            result.put(
                reference,
                entry
            );
        }

        return result;
    }

