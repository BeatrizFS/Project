    private static void handleCancel(String benefitPackageId) {
        try {
            validateWriteToken();

            ServiceContract contract =
                getBenefitPackage(benefitPackageId);

            if (!CANCELLABLE_STATUSES.contains(contract.Package_Status__c)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit package cannot be cancelled because its current status is '
                    + contract.Package_Status__c
                    + '.'
                );
            }

            contract.Package_Status__c = STATUS_CANCELLED;

            // contract.Cancelled_At__c = System.now();

            update contract;

            RestContext.response.statusCode = 204;

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            writeErrorResponse(ex);

        } catch (JSONException ex) {
            writeErrorResponse(
                400,
                'Bad Request',
                'The input information received were not compliant with the endpoint specification.'
            );

        } catch (DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            System.debug(LoggingLevel.ERROR, 'DMLException stack trace: ' + ex.getStackTraceString());

            writeErrorResponse(
                500,
                'database_internal_server_error',
                'Error when try to cancel benefit package.'
            );

        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error cancelling the benefit package: ' + ex.getMessage()
            );
        }
    }

    private static void handleGet() {
        try {
            validateReadToken();

            Map<String, String> requestParams =
                RestContext.request.params;

            Map<String, Integer> paginationParams =
                validateGetRequest(requestParams);

            Integer startIndex =
                paginationParams.get('start_index');

            Integer maxResults =
                paginationParams.get('max_results');

            List<ServiceContract> benefitPackages = [
                SELECT
                    Id,
                    Package_Status__c,
                    Product_Reference__c,
                    StartDate,
                    EndDate,
                    Amount_of_Policies__c
                FROM ServiceContract
                WHERE RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
                ORDER BY CreatedDate DESC
                LIMIT :maxResults
                OFFSET :startIndex
            ];

            // FIX #3: total real de registros (não o tamanho da página atual),
            // necessário para o cliente saber se existem mais páginas.
            Integer totalCount = [
                SELECT COUNT()
                FROM ServiceContract
                WHERE RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            ];

            RestContext.response.statusCode = 200;

            RestContext.response.addHeader(
                'Content-Range',
                WebportalApiUtility_v1.getContentRangeHeader(
                    startIndex,
                    benefitPackages.size(),
                    totalCount
                )
            );

            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(
                        buildBenefitPackageListResponse(benefitPackages),
                        true
                    )
                );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            writeErrorResponse(ex);

        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error retrieving benefit packages: ' + ex.getMessage()
            );
        }
    }

