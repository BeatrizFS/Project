    }

    private static void handlePatch(String benefitPackageId) {
        try {
            validateWriteToken();

            String requestBody = getRequestBody();

            BenefitPackage request =
                (BenefitPackage) JSON.deserializeStrict(
                    requestBody,
                    BenefitPackage.class
                );

            Map<String, Object> body =
                (Map<String, Object>) JSON.deserializeUntyped(requestBody);

            ServiceContract contract =
                getBenefitPackage(benefitPackageId);

            validateDraftStatus(contract, 'updated');

            applyPatch(
                contract,
                request,
                body
            );

            update contract;

            RestContext.response.statusCode = 204;
            RestContext.response.responseBody = null;

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            writeErrorResponse(ex);

        } catch (JSONException ex) {
            writeErrorResponse(
                400,
                'Bad Request',
                'The input information received were not compliant with the endpoint specification.'
            );

        } catch (DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            System.debug(LoggingLevel.ERROR, 'DMLException stack trace: ' + ex.getStackTraceString());

            writeErrorResponse(
                500,
                'database_internal_server_error',
                'Error when try to update benefit package.'
            );

        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error updating the benefit package: ' + ex.getMessage()
            );
        }
    }

    private static void applyPatch(
        ServiceContract contract,
        BenefitPackage request,
        Map<String, Object> body
    ) {
        if (body.containsKey('product_reference')) {
            Product__c product =
                getProduct(request.product_reference);

            contract.Product_Reference__c =
                request.product_reference;

            contract.Product__c =
                product.Id;
        }

        if (body.containsKey('active_start_at')) {
            contract.StartDate =
                normalizeStartDate(
                    request.active_start_at
                );
        }

        if (body.containsKey('active_end_at')) {
            contract.EndDate =
                request.active_end_at;
        }

        if (
            body.containsKey('active_start_at') ||
            body.containsKey('active_end_at')
        ) {
            validateDates(
                contract.StartDate,
                contract.EndDate
            );

            contract.Term =
                calculateWholeMonthTerm(
                    contract.StartDate,
                    contract.EndDate
                );
        }

        if (body.containsKey('amount_of_policies')) {
            validateAmountOfPolicies(
                request.amount_of_policies
            );

            contract.Amount_of_Policies__c =
                request.amount_of_policies;
        }

        if (body.containsKey('affected_policy_range')) {
            applyPolicyRangePatch(
                contract,
                request
            );
        }

        if (body.containsKey('legal_consents')) {
            validateLegalConsents(
                request.legal_consents
            );

            populateLegalConsents(
                contract,
                request
            );
        }

        // FIX #4: rastreia se core/optional benefits foram substituídos
        // neste PATCH, para poder sincronizar o Quantity das linhas
        // remanescentes quando apenas amount_of_policies mudar.
        Boolean coreReplaced =
            body.containsKey('core_benefits');

        Boolean optionalReplaced =
            body.containsKey('optional_benefits');

        if (coreReplaced || optionalReplaced) {
            replaceBenefitLines(
                contract,
                request,
                body
            );
        }

        if (body.containsKey('amount_of_policies')) {
            syncLineItemQuantities(
                contract,
                coreReplaced,
                optionalReplaced
            );
        }
    }

    /**
     * FIX #4: Mantém o Quantity das ContractLineItem existentes
     * sincronizado com o novo Amount_of_Policies__c do contrato,
     * quando o PATCH altera amount_of_policies mas não substitui
     * (via core_benefits/optional_benefits) todas as linhas.
     *
     * Linhas já recriadas por replaceBenefitLines() ficam de fora
     * (já nasceram com o Quantity correto) para evitar update duplicado
     * sobre um Id que acabou de ser deletado/inserido.
     */
    private static void syncLineItemQuantities(
        ServiceContract contract,
        Boolean coreReplaced,
        Boolean optionalReplaced
    ) {
        Integer quantity =
            contract.Amount_of_Policies__c == null
                ? 0
                : Integer.valueOf(
                    contract.Amount_of_Policies__c
                );

        List<ContractLineItem> linesToUpdate =
            new List<ContractLineItem>();

        for (ContractLineItem lineItem :
            contract.ContractLineItems
        ) {
            Boolean alreadyReplaced =
                (
                    coreReplaced &&
                    lineItem.Benefit_Category__c ==
                    CATEGORY_CORE
                ) ||
                (
                    optionalReplaced &&
                    lineItem.Benefit_Category__c ==
                    CATEGORY_OPTIONAL
                );

            if (!alreadyReplaced) {
                linesToUpdate.add(
                    new ContractLineItem(
                        Id = lineItem.Id,
                        Quantity = quantity
                    )
                );
            }
        }

        if (!linesToUpdate.isEmpty()) {
            update linesToUpdate;
        }
    }

    private static void validateCreateRequest(
        BenefitPackage request,
        Date startDate,
        Date endDate
    ) {
        // FIX #1: valida as datas já normalizadas (as que de fato
        // serão persistidas), não o valor bruto do payload.
        validateDates(
            startDate,
            endDate
        );

        validateAmountOfPolicies(
            request.amount_of_policies
        );

        validateCoreBenefits(
            request.core_benefits,
            true
        );

        validateOptionalBenefits(
            request.optional_benefits
        );

        validateLegalConsents(
            request.legal_consents
        );
    }

    // FIX (duplicação): validateCoreBenefitsForCreate e
    // validateCoreBenefitsForPatch foram unificados neste único método.
    private static void validateCoreBenefits(
        List<CoreBenefit> benefits,
        Boolean required
    ) {
        validateBenefitCount(
            benefits == null ? null : benefits.size(),
            'core_benefits',
            required
        );
    }

    private static void validateOptionalBenefits(
        List<OptionalBenefit> benefits
    ) {
        validateBenefitCount(
            benefits == null ? null : benefits.size(),
            'optional_benefits',
            false
        );
    }

    private static void validateBenefitCount(
        Integer count,
        String fieldName,
        Boolean required
    ) {
        if (
            required &&
            (count == null || count == 0)
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                fieldName
                + ' must contain at least one benefit.'
            );
        }

        if (
            count != null &&
            count > MAX_BENEFITS
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                fieldName
                + ' cannot contain more than '
                + MAX_BENEFITS
                + ' benefits.'
            );
        }
    }

    private static void validateLegalConsents(
        List<LegalConsentItem> consents
    ) {
        if (
            consents != null &&
            consents.size() > MAX_LEGAL_CONSENTS
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'legal_consents cannot contain more than '
                + MAX_LEGAL_CONSENTS
                + ' items.'
            );
        }
    }

    private static void validateAmountOfPolicies(
        Integer amountOfPolicies
    ) {
        if (
            amountOfPolicies == null ||
            amountOfPolicies < 1
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'amount_of_policies must be a positive integer.'
            );
        }
    }

    private static void validateCompleteRequest(
        ServiceContract contract
    ) {
        if (String.isBlank(contract.Product_Reference__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Product_Reference__c is required to complete the benefit package.'
            );
        }

        validateAmountOfPolicies(
            contract.Amount_of_Policies__c == null
                ? null
                : Integer.valueOf(
                    contract.Amount_of_Policies__c
                )
        );

        if (contract.StartDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'StartDate is required to complete the benefit package.'
            );
        }

        if (contract.EndDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'EndDate is required to complete the benefit package.'
            );
        }

        validateDates(
            contract.StartDate,
            contract.EndDate
        );

        if (String.isBlank(contract.Policy_Range_Start__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Policy_Range_Start__c is required to complete the benefit package.'
            );
        }

        if (String.isBlank(contract.Policy_Range_End__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Policy_Range_End__c is required to complete the benefit package.'
            );
        }

        validateCoreLineItemExists(
            contract.ContractLineItems
        );

        validateLegalConsents(
            buildLegalConsentResponse(contract)
        );
    }

    private static void validateCoreLineItemExists(
        List<ContractLineItem> lineItems
    ) {
        for (ContractLineItem lineItem : lineItems) {
            if (
                lineItem.Benefit_Category__c ==
                CATEGORY_CORE
            ) {
                return;
            }
        }

        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'At least one Core benefit is required to complete the benefit package.'
        );
    }

    private static void applyPolicyRangePatch(
        ServiceContract contract,
        BenefitPackage request
    ) {
        if (request.affected_policy_range == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range cannot be null.'
            );
        }

        if (
            String.isBlank(
                request.affected_policy_range
                    .external_number_start_at
            )
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range.external_number_start_at is required.'
            );
        }

        if (
            String.isBlank(
                request.affected_policy_range
                    .external_number_end_at
            )
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range.external_number_end_at is required.'
            );
        }

        contract.Policy_Range_Start__c =
            request.affected_policy_range
                .external_number_start_at;

        contract.Policy_Range_End__c =
            request.affected_policy_range
                .external_number_end_at;
    }

    private static void replaceBenefitLines(
        ServiceContract contract,
        BenefitPackage request,
        Map<String, Object> body
    ) {
        Boolean replaceCore =
            body.containsKey('core_benefits');

        Boolean replaceOptional =
            body.containsKey('optional_benefits');

        validateBenefitReplacementRequest(
            request,
            replaceCore,
            replaceOptional
        );

        Map<String, Benefit__c> benefitsByReference =
            getBenefitsByExternalReference(
                request,
                replaceCore,
                replaceOptional
            );

        Map<String, PricebookEntry> pricebookEntriesByBenefit =
            getPricebookEntriesByBenefitReference(
                benefitsByReference,
                CURRENCY_ISO_CODE
            );

        deleteReplacedBenefitLines(
            contract.ContractLineItems,
            replaceCore,
            replaceOptional
        );

        List<ContractLineItem> newLineItems =
            buildPatchContractLineItems(
                contract,
                request,
                replaceCore,
                replaceOptional,
                benefitsByReference,
                pricebookEntriesByBenefit
            );

        if (!newLineItems.isEmpty()) {
            insert newLineItems;
        }
    }

    private static void validateBenefitReplacementRequest(
        BenefitPackage request,
        Boolean replaceCore,
        Boolean replaceOptional
    ) {
        if (replaceCore) {
            validateCoreBenefits(
                request.core_benefits,
                true
            );
        }

        if (replaceOptional) {
            validateBenefitCount(
                request.optional_benefits == null
                    ? null
                    : request.optional_benefits.size(),
                'optional_benefits',
                true
            );
        }
    }

    private static Map<String, Benefit__c> getBenefitsByExternalReference(
        BenefitPackage request
    ) {
        return getBenefitsByExternalReference(
            request,
            true,
            true
        );
