@RestResource(
    urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/*'
)
global with sharing class BenefitsConfigAPIPackages_VEXP {

    private static final String RESOURCE_PATH = '/benefit_packages';

    private static final String ACTION_CANCEL = 'cancel';
    private static final String ACTION_COMPLETE = 'complete';

    private static final String BENEFITS_PRICEBOOK_NAME = 'Visa Benefits';
    private static final String BENEFIT_PACKAGE_RECORD_TYPE = 'Benefit_Package';

    private static final String STATUS_DRAFT = 'Draft';
    private static final String STATUS_AWAITING_START = 'Awaiting Start';
    private static final String STATUS_ACTIVE = 'Active';
    private static final String STATUS_CANCELLED = 'Cancelled';
    private static final String STATUS_EXPIRED = 'Expired';

    private static final String CATEGORY_CORE = 'Core';
    private static final String CATEGORY_OPTIONAL = 'Optional';

    private static final String CURRENCY_ISO_CODE = 'USD';

    private static final Integer MAX_BENEFITS = 100;
    private static final Integer MAX_LEGAL_CONSENTS = 5;
    private static final Integer MAX_PAGINATION_RESULTS = 100;
    private static final Integer MAX_OFFSET = 2000;

    private static final Set<String> CANCELLABLE_STATUSES =
        new Set<String>{
            STATUS_DRAFT,
            STATUS_AWAITING_START,
            STATUS_ACTIVE
        };

    private static final Map<String, String> API_STATUS_BY_SALESFORCE_STATUS =
        new Map<String, String>{
            STATUS_DRAFT => 'DRAFT',
            STATUS_AWAITING_START => 'AWAITING_START',
            STATUS_ACTIVE => 'ACTIVE',
            STATUS_CANCELLED => 'CANCELLED',
            STATUS_EXPIRED => 'EXPIRED'
        };

    private static final Map<String, String> CREATE_REQUIRED_FIELDS =
        new Map<String, String>{
            'product_reference' => 'Primitive',
            'active_start_at' => 'Primitive',
            'active_end_at' => 'Primitive',
            'amount_of_policies' => 'Primitive',
            'affected_policy_range' => 'Object',
            'affected_policy_range.external_number_start_at' => 'Primitive',
            'affected_policy_range.external_number_end_at' => 'Primitive',
            'core_benefits' => 'List',
            'core_benefits.benefit_id' => 'Primitive',
            'core_benefits.name' => 'Primitive',
            'legal_consents' => 'List'
        };


    /* ============================================================
       POST
       ============================================================ */

    @HttpPost
    global static void doPost() {

        setJsonContentType();

        List<String> segments =
            getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleCreate();
            return;
        }

        if (segments.size() == 2 &&
            segments[1] == ACTION_COMPLETE) {

            handleComplete(segments[0]);
            return;
        }

        if (segments.size() == 2 &&
            segments[1] == ACTION_CANCEL) {

            handleCancel(segments[0]);
            return;
        }

        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'not_found',
            'Unknown resource path'
        );
    }


    /* ============================================================
       GET
       ============================================================ */

    @HttpGet
    global static void doGet() {

        setJsonContentType();

        List<String> segments =
            getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleGet();
            return;
        }

        if (segments.size() == 1) {
            handleGetDetails(segments[0]);
            return;
        }

        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'not_found',
            'Unknown resource path'
        );
    }


    /* ============================================================
       PATCH
       ============================================================ */

    @HttpPatch
    global static void doPatch() {

        setJsonContentType();

        List<String> segments =
            getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 1) {
            handlePatch(segments[0]);
            return;
        }

        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'not_found',
            'Unknown resource path'
        );
    }


    /* ============================================================
       CREATE
       ============================================================ */

    private static void handleCreate() {

        try {

            validateWriteToken();

            String requestBody =
                getRequestBody();

            BenefitPackage request =
                deserializeBenefitPackage(requestBody);

            WebportalApiUtility_v1.runValidateRequiredFields(
                requestBody,
                CREATE_REQUIRED_FIELDS
            );

            validateCreateRequest(request);

            Date startDate =
                normalizeStartDate(
                    request.active_start_at
                );

            Date endDate =
                request.active_end_at;

            Product__c product =
                getProduct(
                    request.product_reference
                );

            Map<String, Benefit__c> benefitsByReference =
                getBenefitsByExternalReference(
                    request
                );

            Map<String, PricebookEntry>
                pricebookEntriesByBenefit =
                    getPricebookEntriesByBenefitReference(
                        benefitsByReference,
                        CURRENCY_ISO_CODE
                    );

            Id pricebookId =
                getPricebookId(
                    pricebookEntriesByBenefit
                );

            ServiceContract contract =
                buildServiceContract(
                    request,
                    product,
                    pricebookId,
                    startDate,
                    endDate
                );

            insert contract;

            List<ContractLineItem> lineItems =
                buildContractLineItems(
                    contract.Id,
                    request,
                    startDate,
                    endDate,
                    benefitsByReference,
                    pricebookEntriesByBenefit
                );

            if (!lineItems.isEmpty()) {
                insert lineItems;
            }

            BenefitPackagePostResponse response =
                new BenefitPackagePostResponse();

            response.benefit_package_id =
                contract.Id;

            RestContext.response.statusCode = 201;
            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(response)
                );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            writeErrorResponse(ex);

        } catch (JSONException ex) {

            writeErrorResponse(
                400,
                'Bad Request',
                'The input information received were not compliant with the endpoint specification.'
            );

        } catch (DMLException ex) {

            logException(
                LoggingLevel.ERROR,
                'Error creating benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'database_internal_server_error',
                'Error when trying to create the benefit package.'
            );

        } catch (Exception ex) {

            logException(
                LoggingLevel.ERROR,
                'Unexpected error creating benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error creating the benefit package.'
            );
        }
    }


    /* ============================================================
       COMPLETE
       ============================================================ */

    private static void handleComplete(
        String benefitPackageId
    ) {

        try {

            validateWriteToken();

            ServiceContract contract =
                getBenefitPackage(
                    benefitPackageId
                );

            validateDraftStatus(
                contract,
                'completed'
            );

            validateCompleteRequest(
                contract
            );

            contract.Package_Status__c =
                STATUS_AWAITING_START;

            update contract;

            RestContext.response.statusCode = 204;
            RestContext.response.responseBody = null;

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            writeErrorResponse(ex);

        } catch (DMLException ex) {

            logException(
                LoggingLevel.ERROR,
                'Error completing benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'database_internal_server_error',
                'Error when trying to complete the benefit package.'
            );

        } catch (Exception ex) {

            logException(
                LoggingLevel.ERROR,
                'Unexpected error completing benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error completing the benefit package.'
            );
        }
    }


    /* ============================================================
       CANCEL
       ============================================================ */

    private static void handleCancel(
        String benefitPackageId
    ) {

        try {

            validateWriteToken();

            ServiceContract contract =
                getBenefitPackageForCancel(
                    benefitPackageId
                );

            if (!CANCELLABLE_STATUSES.contains(
                contract.Package_Status__c
            )) {

                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit package cannot be cancelled because its current status is '
                    + contract.Package_Status__c
                    + '.'
                );
            }

            contract.Package_Status__c =
                STATUS_CANCELLED;

            update contract;

            RestContext.response.statusCode = 204;
            RestContext.response.responseBody = null;

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            writeErrorResponse(ex);

        } catch (DMLException ex) {

            logException(
                LoggingLevel.ERROR,
                'Error cancelling benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'database_internal_server_error',
                'Error when trying to cancel the benefit package.'
            );

        } catch (Exception ex) {

            logException(
                LoggingLevel.ERROR,
                'Unexpected error cancelling benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error cancelling the benefit package.'
            );
        }
    }


    /* ============================================================
       GET LIST
       ============================================================ */

    private static void handleGet() {

        try {

            validateReadToken();

            Map<String, Integer> pagination =
                validateGetRequest(
                    RestContext.request.params
                );

            Integer startIndex =
                pagination.get('start_index');

            Integer maxResults =
                pagination.get('max_results');

            List<ServiceContract> contracts = [
                SELECT
                    Id,
                    Package_Status__c,
                    Product_Reference__c,
                    StartDate,
                    EndDate,
                    Amount_of_Policies__c
                FROM ServiceContract
                WHERE RecordType.DeveloperName =
                    :BENEFIT_PACKAGE_RECORD_TYPE
                ORDER BY CreatedDate DESC
                LIMIT :maxResults
                OFFSET :startIndex
            ];

            RestContext.response.statusCode = 200;

            RestContext.response.addHeader(
                'Content-Range',
                WebportalApiUtility_v1.getContentRangeHeader(
                    startIndex,
                    contracts.size(),
                    contracts.size()
                )
            );

            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(
                        buildBenefitPackageListResponse(
                            contracts
                        ),
                        true
                    )
                );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            writeErrorResponse(ex);

        } catch (Exception ex) {

            logException(
                LoggingLevel.ERROR,
                'Unexpected error retrieving benefit packages',
                ex
            );

            writeErrorResponse(
                500,
                'Internal Server Error',
                'Unexpected error retrieving benefit packages.'
            );
        }
    }


    /* ============================================================
       GET DETAILS
       ============================================================ */

    private static void handleGetDetails(
        String benefitPackageId
    ) {

        try {

            validateReadToken();

            ServiceContract contract =
                getBenefitPackage(
                    benefitPackageId
                );

            List<ContractLineItem> lineItems = [
                SELECT
                    Id,
                    Benefit_Category__c,
                    PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c,
                    PricebookEntry.Product2.Benefit__r.Name,
                    PricebookEntry.Product2.Benefit__r.Benefit_Description__c
                FROM ContractLineItem
                WHERE ServiceContractId =
                    :contract.Id
                ORDER BY CreatedDate ASC
            ];

            RestContext.response.statusCode = 200;

            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(
                        buildBenefitPackageResponse(
                            contract,
                            lineItems
                        )
                    )
                );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {

            writeErrorResponse(ex);

        } catch (Exception ex) {

            logException(
                LoggingLevel.ERROR,
                'Unexpected error retrieving benefit package',
                ex
            );

            writeErrorResponse(
                500,
                'internal_server_error',
                'Unexpected error retrieving the benefit package.'
            );
        }
    }


    /* ============================================================
       PATCH
       ============================================================ */

    private static void handlePatch(
        String benefitPackageId
    ) {

        try {

            validateWriteToken();

            String requestBody =
                getRequestBody();

            BenefitPackage request =
                deserializeBenefitPackage(
                    requestBody
                );

            Map<String, Object> body =
                (Map<String, Object>)
                JSON.deserializeUntyped(
                    requestBody
                );

            ServiceContract contract =
                getBenefitPackage(
                    benefitPackageId
                );

            validateDraftStatus(
                contract,
                'updated'
            );

            applyPatch(
                contract,
