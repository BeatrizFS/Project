            statusCode;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(statusCode),
                        error,
                        description
                    )
                )
            );
    }


    private static void logException(
        LoggingLevel level,
        String message,
        Exception ex
    ) {

        System.debug(
            level,
            message
            + ' | type='
            + ex.getTypeName()
            + ' | message='
            + ex.getMessage()
            + ' | stack='
            + ex.getStackTraceString()
        );
    }


