    private static void validateCreateRequest(BenefitPackage request) {
        if (request.active_end_at <= request.active_start_at) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_end_at must be greater than active_start_at.');
        }
        if (request.amount_of_policies == null || request.amount_of_policies < 1) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'amount_of_policies must be a positive integer.');
        }
        if (request.core_benefits == null || request.core_benefits.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'core_benefits must contain at least one benefit.');
        }
        if (request.core_benefits.size() > 100) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'core_benefits cannot contain more than 100 benefits.');
        }
        if (request.optional_benefits != null && request.optional_benefits.size() > 100) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'optional_benefits cannot contain more than 100 benefits.'
            );
        }
        if (request.legal_consents != null && request.legal_consents.size() > 5) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'legal_consents cannot contain more than 5 items.');
        }
    }

    private static void validateCompleteRequest(ServiceContract contract) {
        if (String.isBlank(contract.Product_Reference__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Product_Reference__c is required to complete the benefit package.');
        }
        if (contract.Amount_of_Policies__c == null || contract.Amount_of_Policies__c < 1) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Amount_of_Policies__c must be at least 1 to complete the benefit package.');
        }
        if (contract.StartDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'StartDate is required to complete the benefit package.');
        }
        if (contract.EndDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'EndDate is required to complete the benefit package.');
        }
        if (contract.EndDate <= contract.StartDate) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'EndDate must be greater than StartDate.');
        }
        if (String.isBlank(contract.Policy_Range_Start__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Policy_Range_Start__c is required to complete the benefit package.');
        }
        if (String.isBlank(contract.Policy_Range_End__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Policy_Range_End__c is required to complete the benefit package.');
        }

        Boolean hasCoreBenefit = false;

        for (ContractLineItem lineItem : contract.ContractLineItems) {
            if (lineItem.Benefit_Category__c == 'Core') {
                hasCoreBenefit = true;
                break;
            }
        }
        if (!hasCoreBenefit) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'At least one Core benefit is required to complete the benefit package.');
        }
    }

    private static void validateDates(Date startDate, Date endDate) {
        if (startDate == null || endDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_start_at and active_end_at are required.');
        }
        if (endDate <= startDate) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_end_at must be greater than active_start_at.');
        }
    }

