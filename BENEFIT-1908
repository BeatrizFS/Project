    private static Product__c getProduct(String productReference) {
        List<Product__c> products = [SELECT Id FROM Product__c WHERE Key__c = :productReference LIMIT 1];
        if (products.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Product with reference ' + productReference + ' not found.');
        }
        return products[0];
    }

    private static Map<String, Benefit__c> getBenefitsByExternalReference(BenefitPackage request) {
        Set<String> requestedBenefitIds = new Set<String>();

        for (CoreBenefit coreBenefit : request.core_benefits) {
            requestedBenefitIds.add(coreBenefit.benefit_id);
        }

        if (request.optional_benefits != null) {
            for (OptionalBenefit optionalBenefit : request.optional_benefits) {
                requestedBenefitIds.add(optionalBenefit.benefit_id);
            }
        }

        List<Benefit__c> benefits = [SELECT Id, Visa_External_Reference__c, Name, Benefit_Description__c FROM Benefit__c WHERE Visa_External_Reference__c IN :requestedBenefitIds];
        Map<String, Benefit__c> benefitsByReference = new Map<String, Benefit__c>();

        for (Benefit__c benefit : benefits) {
            benefitsByReference.put(benefit.Visa_External_Reference__c, benefit);
        }

        for (String benefitId : requestedBenefitIds) {
            if (!benefitsByReference.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + benefitId + ' was not found in the catalogue.');
            }
        }
        return benefitsByReference;
    }

    private static Map<String, PricebookEntry> getPricebookEntriesByBenefitReference(Map<String, Benefit__c> benefitsByReference, String currencyIsoCode) {
        Set<Id> benefitIds = new Set<Id>();

        for (Benefit__c benefit : benefitsByReference.values()) {
            benefitIds.add(benefit.Id);
        }

        List<PricebookEntry> entries = [
            SELECT Id, Product2Id, Product2.Benefit__c, Product2.Benefit__r.Visa_External_Reference__c, Product2.Benefit__r.Name, Product2.Benefit__r.Benefit_Description__c, Pricebook2Id, UnitPrice 
            FROM PricebookEntry
            WHERE Pricebook2.Name =:BENEFITS_PRICEBOOK_NAME
                AND Pricebook2.IsActive = true
                AND Product2.Benefit__c IN :benefitIds
                AND Product2.Family = 'Benefit'
                AND Product2.IsActive = true
                AND CurrencyIsoCode = :currencyIsoCode
                AND IsActive = true
            LIMIT 200
        ];

        Map<Id, PricebookEntry> entriesByBenefitId = new Map<Id, PricebookEntry>();

        for (PricebookEntry entry : entries) {
            Id benefitId = entry.Product2.Benefit__c;
            if (entriesByBenefitId.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400, 'bad_request', 'More than one active PricebookEntry was found for Benefit ' + String.valueOf(benefitId) + '.');
            }
            entriesByBenefitId.put(benefitId, entry);
        }


        Map<String, PricebookEntry> result = new Map<String, PricebookEntry>();

        for (String reference : benefitsByReference.keySet()) {
            Benefit__c benefit = benefitsByReference.get(reference);
            PricebookEntry entry = entriesByBenefitId.get(benefit.Id);
            if (entry == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + reference + ' is not available for the bank currency ' + currencyIsoCode + '.');
            }
            result.put(reference, entry);
        }

        return result;
    }


    private static Id getPricebookId(Map<String, PricebookEntry> pricebookEntriesByBenefit) {
        for (PricebookEntry entry : pricebookEntriesByBenefit.values()) {
            return entry.Pricebook2Id;
        }
        throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefits pricebook is not configured.');
    }

    private static ServiceContract buildServiceContract(BenefitPackage request, Product__c product, Id pricebookId, Date startDate, Date endDate) {
        ServiceContract contract = new ServiceContract();
        contract.Name = '-';
        contract.RecordTypeId = Schema.SObjectType.ServiceContract.getRecordTypeInfosByDeveloperName().get(BENEFIT_PACKAGE_RECORD_TYPE).getRecordTypeId();
        contract.Pricebook2Id = pricebookId;
        contract.Package_Status__c = 'Draft';
        contract.Product_Reference__c = request.product_reference;
        contract.Product__c = product.Id;
        contract.StartDate = startDate;
        contract.EndDate = endDate;
        contract.Term = calculateWholeMonthTerm(startDate, endDate);
        contract.Amount_of_Policies__c = request.amount_of_policies;
        contract.Policy_Range_Start__c = request.affected_policy_range.external_number_start_at;
        contract.Policy_Range_End__c = request.affected_policy_range.external_number_end_at;

        populateLegalConsents(contract, request);

        return contract;
    }

    private static List<ContractLineItem> buildContractLineItems(Id contractId, BenefitPackage request, Date startDate, Date endDate, Map<String, Benefit__c> benefitsByReference, Map<String, PricebookEntry> pricebookEntriesByBenefit) {
        List<ContractLineItem> lineItems = new List<ContractLineItem>();
        Integer quantity = request.amount_of_policies;

        for (CoreBenefit coreBenefit : request.core_benefits) {
            Benefit__c benefit = benefitsByReference.get(coreBenefit.benefit_id);
            PricebookEntry pricebookEntry = pricebookEntriesByBenefit.get(coreBenefit.benefit_id);
            lineItems.add(
                buildContractLineItem(
                    contractId,
                    quantity,
                    startDate,
                    endDate,
                    benefit,
                    pricebookEntry,
                    'Core',
                    0
                )
            );
        }

        if (request.optional_benefits != null) {
            for (OptionalBenefit optionalBenefit : request.optional_benefits) {
                Benefit__c benefit = benefitsByReference.get(optionalBenefit.benefit_id);
                PricebookEntry pricebookEntry = pricebookEntriesByBenefit.get(optionalBenefit.benefit_id);
                lineItems.add(
                    buildContractLineItem(
                        contractId,
                        quantity,
                        startDate,
                        endDate,
                        benefit,
                        pricebookEntry,
                        'Optional',
                        pricebookEntry.UnitPrice
                    )
                );
            }
        }
        return lineItems;
    }

    private static ContractLineItem buildContractLineItem(Id contractId, Integer quantity, Date startDate, Date endDate, Benefit__c benefit, PricebookEntry pricebookEntry, String category, Decimal unitPrice) {
        
        if (benefit == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit could not be resolved.');
        }
        if (pricebookEntry == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'No PricebookEntry was found for benefit ' + benefit.Name + '.');
        }

        return new ContractLineItem(
            ServiceContractId = contractId,
            PricebookEntryId = pricebookEntry.Id,
            Benefit_Category__c = category,
            Quantity = quantity,
            UnitPrice = unitPrice,
            StartDate = startDate,
            EndDate = endDate
        );
    }

    private static BenefitPackage buildBenefitPackageResponse(ServiceContract contract, List<ContractLineItem> lineItems) {
        BenefitPackage response = initializeBenefitPackageResponse(contract);
        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == 'Core') {
                response.core_benefits.add(buildCoreBenefit(lineItem));
            } else if (lineItem.Benefit_Category__c == 'Optional') {
                response.optional_benefits.add(buildOptionalBenefit(lineItem));
            }
        }
        return response;
    }

    private static BenefitPackage initializeBenefitPackageResponse(ServiceContract contract) {
        BenefitPackage response = new BenefitPackage();
        response.status = contract.Package_Status__c;
        response.benefit_package_id = contract.Id;
        response.product_reference = contract.Product_Reference__c;
        response.active_start_at = contract.StartDate;
        response.active_end_at = contract.EndDate;
        response.amount_of_policies = contract.Amount_of_Policies__c == null ? null : Integer.valueOf(contract.Amount_of_Policies__c);
        response.affected_policy_range = buildAffectedPolicyRange(contract);
        response.core_benefits = new List<CoreBenefit>();
        response.optional_benefits = new List<OptionalBenefit>();
        response.legal_consents = buildLegalConsentResponse(contract);
        return response;
    }
    
    private static AffectedPolicyRange buildAffectedPolicyRange(ServiceContract contract) {
        AffectedPolicyRange affectedPolicyRange = new AffectedPolicyRange();
        affectedPolicyRange.external_number_start_at = contract.Policy_Range_Start__c;
        affectedPolicyRange.external_number_end_at = contract.Policy_Range_End__c;
        return affectedPolicyRange;
    }

    private static CoreBenefit buildCoreBenefit(ContractLineItem lineItem) {
        CoreBenefit coreBenefit = new CoreBenefit();
        coreBenefit.benefit_id = lineItem.PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c;
        coreBenefit.name = lineItem.PricebookEntry.Product2.Benefit__r.Name;
        return coreBenefit;
    }

    private static OptionalBenefit buildOptionalBenefit(ContractLineItem lineItem) {
        OptionalBenefit optionalBenefit = new OptionalBenefit();
        optionalBenefit.benefit_id = lineItem.PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c;
        optionalBenefit.name = lineItem.PricebookEntry.Product2.Benefit__r.Name;
        optionalBenefit.description = lineItem.PricebookEntry.Product2.Benefit__r.Benefit_Description__c;
        return optionalBenefit;
    }

    private static List<LegalConsentItem> buildLegalConsentResponse(ServiceContract contract) {
        List<LegalConsentItem> legalConsents = new List<LegalConsentItem>();
        
        if (String.isBlank(contract.Legal_Consent_Code__c)) {
            return legalConsents;
        }
        LegalConsentItem consent = new LegalConsentItem();
        consent.code = contract.Legal_Consent_Code__c;
        consent.is_confirmed = contract.Legal_Consent_Confirmed__c;
        consent.consented_at = contract.Legal_Consent_Date__c == null ? null : contract.Legal_Consent_Date__c.formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'');
        legalConsents.add(consent);
        return legalConsents;
    }

    private static void populateLegalConsents(ServiceContract contract, BenefitPackage request) {
        if (request.legal_consents == null || request.legal_consents.isEmpty()) {
            return;
        }

        LegalConsentItem consent = request.legal_consents[0];

        contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(contract, 'Legal_Consent_Code__c', consent.code, false);
        contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(contract, 'Legal_Consent_Confirmed__c', consent.is_confirmed != null ? consent.is_confirmed : false);

        if (String.isNotBlank(consent.consented_at)) {
            String value = consent.consented_at;

            if (value.endsWith('Z')) {
                value = value.substring(0, value.length() - 1);
            }

            value = value.replace('T', ' ');
            Datetime consentedAt = Datetime.valueOfGmt(value);

            contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(contract, 'Legal_Consent_Date__c', consentedAt, false);
        }
    }

    private static Integer calculateWholeMonthTerm(Date startDate, Date endDate) {
        Integer months = ((endDate.year() - startDate.year()) * 12) + (endDate.month() - startDate.month());
        if (endDate.day() < startDate.day()) {
            months--;
        }
        return months < 1 ? 1 : months;
    }

    private static ServiceContract getBenefitPackage(String benefitPackageId) {
        List<ServiceContract> packages = [
            SELECT Id, Package_Status__c, Product_Reference__c, Product__c, Pricebook2Id, 
            StartDate, EndDate, Term, 
            Amount_of_Policies__c, Policy_Range_Start__c, Policy_Range_End__c,
            Legal_Consent_Code__c, Legal_Consent_Confirmed__c, Legal_Consent_Date__c,
                (SELECT Id, Benefit_Category__c FROM ContractLineItems)
            FROM ServiceContract
            WHERE Id = :benefitPackageId
                AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        if (packages.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'The searched resource was not found.');
        }
        return packages[0];
    }

    private static void applyPatch(ServiceContract contract, BenefitPackage request, Map<String, Object> body) {
        if (body.containsKey('product_reference')) {
            Product__c product = getProduct(request.product_reference);
            contract.Product_Reference__c = request.product_reference;
            contract.Product__c = product.Id;
        }
        if (body.containsKey('active_start_at')) {
            contract.StartDate = request.active_start_at;
        }
        if (body.containsKey('active_end_at')) {
            contract.EndDate = request.active_end_at;
        }
        if (body.containsKey('active_start_at') || body.containsKey('active_end_at')) {
            validateDates(contract.StartDate, contract.EndDate);
            contract.Term = calculateWholeMonthTerm(contract.StartDate, contract.EndDate);
        }
        if (body.containsKey('amount_of_policies')) {
            if (request.amount_of_policies == null || request.amount_of_policies < 1) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request','amount_of_policies must be a positive integer.');
            }
            contract.Amount_of_Policies__c = request.amount_of_policies;
        }
        if (body.containsKey('affected_policy_range')) {
            if (request.affected_policy_range == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range cannot be null.');
            }
            if (String.isBlank(request.affected_policy_range.external_number_start_at)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range.external_number_start_at is required.');
            }
            if (String.isBlank(request.affected_policy_range.external_number_end_at)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range.external_number_end_at is required.');
            }
            contract.Policy_Range_Start__c = request.affected_policy_range.external_number_start_at;
            contract.Policy_Range_End__c = request.affected_policy_range.external_number_end_at;
        }
        if (body.containsKey('legal_consents')) {
            populateLegalConsents(contract, request);
        }
        if (body.containsKey('core_benefits') || body.containsKey('optional_benefits')) {
            replaceBenefitLines(contract, request, body);
        }
    }

    private static void replaceBenefitLines(ServiceContract contract, BenefitPackage request, Map<String, Object> body) {
        Boolean replaceCore = body.containsKey('core_benefits');
        Boolean replaceOptional = body.containsKey('optional_benefits');

        if (replaceCore) {
            if (request.core_benefits == null || request.core_benefits.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'core_benefits must contain at least one benefit.');
            }
            if (request.core_benefits.size() > 100) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'core_benefits cannot contain more than 100 benefits.');
            }
        }

        if (replaceOptional) {
            if (request.optional_benefits == null || request.optional_benefits.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'optional_benefits must contain at least one benefit.');
            }
            if (request.optional_benefits.size() > 100) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'optional_benefits cannot contain more than 100 benefits.');
            }
        }

        Map<String, Benefit__c> benefitsByReference = new Map<String, Benefit__c>();
        Set<String> requestedBenefitReferences = new Set<String>();

        if (replaceCore) {
            for (CoreBenefit benefit : request.core_benefits) {
                requestedBenefitReferences.add(benefit.benefit_id);
            }
        }

        if (replaceOptional) {
            for (OptionalBenefit benefit : request.optional_benefits) {
                requestedBenefitReferences.add(benefit.benefit_id);
            }
        }

        List<Benefit__c> benefits = [
            SELECT Id, Visa_External_Reference__c, Name, Benefit_Description__c
            FROM Benefit__c
            WHERE Visa_External_Reference__c IN :requestedBenefitReferences
        ];

        for (Benefit__c benefit : benefits) {
            benefitsByReference.put(benefit.Visa_External_Reference__c, benefit);
        }

        for (String reference : requestedBenefitReferences) {
            if (!benefitsByReference.containsKey(reference)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + reference + ' was not found in the catalogue.');
            }
        }

        Map<String, PricebookEntry> pricebookEntriesByBenefit = getPricebookEntriesByBenefitReference(benefitsByReference, 'USD');
        
        List<ContractLineItem> linesToDelete = new List<ContractLineItem>();

        for (ContractLineItem lineItem : contract.ContractLineItems) {
            if (replaceCore && lineItem.Benefit_Category__c == 'Core') {
                linesToDelete.add(lineItem);
            }
            if (replaceOptional && lineItem.Benefit_Category__c == 'Optional') {
                linesToDelete.add(lineItem);
            }
        }

        if (!linesToDelete.isEmpty()) {
            delete linesToDelete;
        }

        List<ContractLineItem> newLineItems = new List<ContractLineItem>();

        Integer quantity = contract.Amount_of_Policies__c == null ? 0 : Integer.valueOf(contract.Amount_of_Policies__c);

        if (replaceCore) {
            for (CoreBenefit coreBenefit : request.core_benefits) {
                newLineItems.add(
                    buildContractLineItem(
                        contract.Id,
                        quantity,
                        contract.StartDate,
                        contract.EndDate,
                        benefitsByReference.get(coreBenefit.benefit_id),
                        pricebookEntriesByBenefit.get(coreBenefit.benefit_id),
                        'Core',
                        0
                    )
                );
            }
        }
        if (replaceOptional) {
            for (OptionalBenefit optionalBenefit :
                request.optional_benefits) {
                PricebookEntry pricebookEntry = pricebookEntriesByBenefit.get(optionalBenefit.benefit_id);

                newLineItems.add(
                    buildContractLineItem(
                        contract.Id,
                        quantity,
                        contract.StartDate,
                        contract.EndDate,
                        benefitsByReference.get(optionalBenefit.benefit_id),
                        pricebookEntry,
                        'Optional',
                        pricebookEntry.UnitPrice
                    )
                );
            }
        }
        if (!newLineItems.isEmpty()) {
            insert newLineItems;
        }
    }

    private static List<String> getResourceSegments(String resourcePath) {
        String requestUri = RestContext.request?.requestURI;

        if (String.isBlank(requestUri) || String.isBlank(resourcePath)) {
            return new List<String>();
        }

        requestUri = requestUri.split('\\?')[0];
        
        String suffix = requestUri.substringAfter(resourcePath);
        if (String.isBlank(suffix) || suffix == '/') {
            return new List<String>{ '' };
        }
        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        List<String> segments = new List<String>();
        String path = suffix.substring(1);
        for (String segment : path.split('/')) {
            segments.add(segment);
        }

        return segments;
    }

