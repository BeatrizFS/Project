			reimbusermentResponse.intermediary_bank_name = reimbuserment.Intermediary_Bank_Name__c != null ? reimbuserment.Intermediary_Bank_Name__c : '';					
			reimbusermentResponse.total_amount_reimbursed = new Amount();
			reimbusermentResponse.total_amount_reimbursed.currencyValue = reimbuserment.Case__r.CurrencyIsoCode;
			reimbusermentResponse.total_amount_reimbursed.value = 0;

			if(paymentsMap.containsKey(reimbuserment.Case__c)) {
				
				for(Underwriter_decision__c payment : paymentsMap.get(reimbuserment.Case__c)) {
					if (reimbuserment.CreatedDate >= Date.valueOf('2024-08-08')) {
						reimbusermentResponse.total_amount_reimbursed.currencyValue = payment.CurrencyIsoCode;
						reimbusermentResponse.total_amount_reimbursed.value += payment.Amount_payed_USD__c != null ? payment.Amount_payed_USD__c : reimbusermentResponse.total_amount_reimbursed.value;
					}
				}
