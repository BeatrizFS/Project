	private Registration selectRegistrationForCountry(List<Registration> registrations, String countryCode) {
		if (registrations == null || registrations.isEmpty()) {
			return null;
		}

		String normalizedCountry = String.isBlank(countryCode) ? '' : countryCode.trim().toUpperCase();
		String countryRegistrationType;

		if (normalizedCountry == 'AR') {
			countryRegistrationType = 'CUIT';
		} else if (normalizedCountry == 'CO' || normalizedCountry == 'PE' || normalizedCountry == 'CL' || normalizedCountry == 'EC') {
			countryRegistrationType = 'ID_CARD';
		}

		if (countryRegistrationType != null) {
			for (Integer i = registrations.size() - 1; i >= 0; i--) {
				Registration registration = registrations[i];

				if (registration != null && registration.registration_type != null && registration.registration_type.equalsIgnoreCase(countryRegistrationType)) {
					return registration;
				}
			}
		}

		return registrations[0];
	}

	private List<ReimbusermentResponse> getReimbuserments(List<BankTransfer__c> reimbuserments) {
		List<ReimbusermentResponse> reimbusermentsResponses = new List<ReimbusermentResponse>();

		Set<String> claimsIDS = new Set<String>();
		for(BankTransfer__c reimbuserment : reimbuserments) {
			claimsIDS.add(reimbuserment.Case__c);
		}

		Map<String,List<Underwriter_decision__c>> paymentsMap = new Map<String,List<Underwriter_decision__c>>();
		for(Underwriter_decision__c payment : [Select Id, Case__c, Amount_payed_USD__c, CurrencyIsoCode from Underwriter_decision__c where Case__c in :claimsIDS and Underwriter_decision_type__c in ('Approved','Paid') ]) {
			if(!paymentsMap.containsKey(payment.Case__c)) {
				paymentsMap.put(payment.Case__c, new List<Underwriter_decision__c>());
			}

			paymentsMap.get(payment.Case__c).add(payment);
		}

		for(BankTransfer__c reimbuserment : reimbuserments) {
			ReimbusermentResponse reimbusermentResponse = new ReimbusermentResponse();
			reimbusermentResponse.reimbursement_id = reimbuserment.Id;
			String holderName = (reimbuserment.BankAccountHolder_Person_First_Name__c != null ? reimbuserment.BankAccountHolder_Person_First_Name__c : ' ') + ' ' + (reimbuserment.BankAccountHolder_Person_Last_Name__c != null ? reimbuserment.BankAccountHolder_Person_Last_Name__c : '');
