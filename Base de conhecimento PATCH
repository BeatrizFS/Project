    private static void handleGet() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        String customerId = RestContext.request.requestURI.substringBetween( '/customers/', '/notifications');
        Map<String, String> params = RestContext.request.params;
        Map<String, Integer> validatedPaginatedParams;      

        Boolean hasBeenAuthenticated = isAuthenticated(
            customerId,
            new Set<string> {
                'urn:axa.partners.specific.visagateway.customers.read_only',
                'urn:axa.partners.specific.visagateway.customers.write',
                'urn:axa.partners.benefits_platform.read_only'
            }
        );

        if( hasBeenAuthenticated || Test.isRunningTest()) {

            if( String.isBlank( customerId ) ) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Empty Customer Id')));
            } else if( !WebportalApiUtility_v1.isValidCustomerID(customerId) ) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Invalid Customer Id')));
            } else {
                Boolean areValidParams = true;
                try {
                    validateGetParams(params);
                    validatedPaginatedParams = WebportalApiUtility_v1.validatePaginationQueryParams(params, 15);
                } catch( WebportalApiUtility_v1.RequestAPIException ex ) {
                    RestContext.response.statuscode = ex.status_code;
                    RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage(String.valueOf(ex.status_code), ex.error,  ex.error_description)));
                    areValidParams = false;
                }

                if(areValidParams) {
                    Boolean isArchived = false;
                    Boolean isRead = false;
                    String relatedTo;

                    isArchived = params.containsKey('was_archived') ? Boolean.valueOf( params.get('was_archived') ) : false;
                    isRead  = params.containsKey('was_read') ? Boolean.valueOf(params.get('was_read') ) : false;
                    relatedTo = params.containsKey('related_to') ? (String) params.get('related_to') : null;

                    String notificationId = RestContext.request.requestURI.substringAfter('/notifications/');

                    String query = 'Select Id, Customer__c, Claim__c, Certificate__c, Travel__c, Title__c, Is_Archived__c, Is_Read__c, Related_to__c, Content__c, CreatedDate from Customer_Notification__c where Customer__r.Customer_Identifier__c = :customerId';

                    if( String.isBlank( notificationId ) ) {
                        query += isArchived ? ' AND Is_Archived__c = true' : (params.containsKey('was_archived') ? ' AND Is_Archived__c = false' : '');
                        query += isRead ? ' AND Is_Read__c = true' : ( params.containsKey('was_read') ? ' AND Is_Read__c = false' : '');
                        query += relatedTo != null ? ' AND Related_to__c = :relatedTo' : '';
                        query += ' ORDER BY CreatedDate DESC';

                        List<Customer_Notification__c> customerNotifications = Database.query(query);
                        List<Customer_Notification__c> paginatedNotifications = WebportalApiUtility_v1.getPaginatedSObject(customerNotifications, validatedPaginatedParams.get('start_index'), validatedPaginatedParams.get('max_results'), customerNotifications.size());

                        List<OtherNotificationSummary> notifications = new List<OtherNotificationSummary>();
                        for( Customer_Notification__c customerNotification : paginatedNotifications ) {
                            notifications.add( getNotificationSummary(customerNotification) );
                        }

                        RestContext.response.statuscode = 206;
                        RestContext.response.addHeader('Content-Range', WebportalApiUtility_v1.getContentRangeHeader(validatedPaginatedParams.get('start_index'), paginatedNotifications.size(), customerNotifications.size()));
                        RestContext.response.responseBody = Blob.valueOf( JSON.serializePretty(  notifications, true ) );
                    } else {
                        if( !WebportalApiUtility_v1.isValidSalesforceID( notificationId ) ) {
                            RestContext.response.statuscode = 400;
                            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Invalid Notification Id')));
                        } else {
                            query += ' AND Id = :notificationId';

                            List<Customer_Notification__c> customerNotifications = Database.query(query);
                            if( customerNotifications.size() == 0 ) {
                                RestContext.response.statuscode = 404;
                                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('404','not_found', 'Notification not found')));
                            } else {
                                Customer_Notification__c customerNotification = customerNotifications[0];
                                OtherNotification notification = getNotificationDetail(customerNotification);
                                RestContext.response.responseBody = Blob.valueOf( JSON.serializePretty(  notification ) );
                                RestContext.response.statuscode = 200;
                            }
                        }
                    }
                }
            }
        }
    }

    private static void handlePatch() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        String customerId = RestContext.request.requestURI.substringBetween( '/customers/', '/notifications');

        Boolean hasBeenAuthenticated = isAuthenticated(
            customerId,
            new Set<string> {
                'urn:axa.partners.specific.visagateway.customers.write',
                'urn:axa.partners.benefits_platform.write'
            }
        );

        if( hasBeenAuthenticated || Test.isRunningTest() ) {
            String notificationId = RestContext.request.requestURI.substringAfter( '/notifications/');

            if( String.isBlank( customerId ) ) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Empty Customer Id')));
            } else if( String.isBlank( notificationId ) ) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Empty Notification Id')));
            } else if( !WebportalApiUtility_v1.isValidCustomerID(customerId) ) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Invalid Customer Id')));
            } else if( !WebportalApiUtility_v1.isValidSalesforceID( notificationId ) ) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Invalid Notification Id')));
            } else {
                List<Customer_Notification__c> notifications = [Select Id, Is_Archived__c, Is_Read__c from Customer_Notification__c where Customer__r.Customer_Identifier__c = :customerId AND Id = :notificationId];
                if( notifications.size() == 0 ) {
                    RestContext.response.statuscode = 404;
                    RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('404','not_found', 'Notification not found')));
                } else {
                    Customer_Notification__c notification = notifications[0];

                    String jsonRequest = RestContext.request.requestBody.toString();
                    if( String.isBlank( jsonRequest ) ) {
                        RestContext.response.statuscode = 400;
                        RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Empty Request body')));
                    } else {
                        Boolean isValidJSON = false;
                        NotificationPatch request;
                        try {
                            request = (NotificationPatch) JSON.deserializeStrict(jsonRequest, NotificationPatch.class);
                            isValidJSON = true;
                        } catch( Exception e ) {
                            RestContext.response.statuscode = 400;
                            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400','bad_request', 'Invalid JSON body')));
                        }

                        if( isValidJSON ) {
                            if( request.was_archived != null ) {
                                notification.Is_Archived__c = request.was_archived;
                            }

                            if( request.was_read != null ) {
                                notification.Is_Read__c = request.was_read;
                            }

                            update notification;
                            RestContext.response.statuscode = 204;
                        }
                    }
                }
            }
        }
    }

    private static void handlePatch() {
        try {
            String customerId = RestContext.request.requestURI.substringBetween('/customers/','/policies/');

            String accessTokenAud = validateAuth(customerId, false);

            Account existingCustomer = getCustomer(customerId);

            Id policyId = validatePolicy();

            String processedRequestBody = getDecryptedAndSanitizedBody(accessTokenAud);

            Policy policyRequestBody = (Policy) JSON.deserializeStrict(processedRequestBody, Policy.class);

            if (
                policyRequestBody.product_criteria != null &&
                policyRequestBody.product_criteria.credit_card_token == null
            ) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'Bad Request',
                    'Field credit_card_token is required for product_criteria'
                );
            }

            Boolean isPolicyFound = false;
            List<MN_Account_BIN__c> existingPolicies = getExistingPolicies(existingCustomer.Id);
            for (MN_Account_BIN__c existing : existingPolicies) {
                if (existing.Id == policyId) {
                    if (
                        existing.BIN__r.Is_Token_Required__c &&
                        String.isBlank(existing.Credit_Card_Token__c) &&
                        policyRequestBody.product_criteria?.credit_card_token == null
                    ) {
                        throw new WebportalApiUtility_v1.RequestAPIException(
                            400,
                            'Bad Request',
                            'Credit card token is empty in the database and is required for this BIN'
                        );
                    }

                    validateCard(existing.BIN__r, policyRequestBody.product_criteria?.credit_card_token);

                    isPolicyFound = true;
                    updatePolicyFields(existing, policyRequestBody);
                } else if (policyRequestBody.is_preferred) {
                    existing.Is_Preferred__c = false;
                }
            }

            if (!isPolicyFound) {
                throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'Policy not found');
            }

            update existingPolicies;

            RestContext.response.statusCode = 204;
        } catch(WebportalApiUtility_v1.RequestAPIException error) {
            RestContext.response.statuscode = error.status_code;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    String.valueOf(error.status_code),
                    error.error,
                    error.error_description
                )
            ));
        } catch(JSONException error) {
            System.debug(LoggingLevel.WARN, 'Body does not match with Policy API contract.');
            System.debug(LoggingLevel.DEBUG, error.getMessage());

            RestContext.response.statuscode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '400',
                    'Bad Request',
                    'Invalid Policy JSON body'
                )
            ));
        } catch(DMLException error) {
            System.debug(LoggingLevel.DEBUG, error.getMessage());

            if (error.getMessage().containsIgnoreCase('duplicate value found')) {
                RestContext.response.statuscode = 400;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '400',
                        'Bad Request',
                        'Credit card token already exists'
                    )
                ));
            } else {
                RestContext.response.statuscode = 500;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'An error occurred while updating the policy.'
                    )
                ));
            }
        } catch (Exception error) {
            System.debug(LoggingLevel.DEBUG, error.getMessage());
            System.debug(LoggingLevel.INFO, error.getStackTraceString());

            RestContext.response.statuscode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'Internal Server Error',
                    null
                ),
                true
            ));
        }
    }

    private static void handleDelete() {
        try {
            String customerId = RestContext.request.requestURI.substringBetween('/customers/','/policies/');
            validateAuth(customerId, false);

            Id policyId = validatePolicy();

            List<MN_Account_BIN__c> deleteMnAccountBIN = [
                SELECT Id, Credit_Card_Token__c, Is_Deleted__c
                FROM MN_Account_BIN__c
                WHERE Id = :policyId
                    AND Customer__r.Customer_Identifier__c = :customerId
                LIMIT 1
            ];

            if (deleteMnAccountBIN.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'Policy not found');
            }

            deleteMnAccountBIN[0].Credit_Card_Token__c =
                deleteMnAccountBIN[0].Credit_Card_Token__c + '-' + Datetime.now().format('yyyyMMddhhmmssSSS');
            deleteMnAccountBIN[0].Is_Deleted__c = true;
            update deleteMnAccountBIN[0];

            RestContext.response.statuscode = 204;
        } catch(WebportalApiUtility_v1.RequestAPIException error) {
            RestContext.response.statuscode = error.status_code;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    String.valueOf(error.status_code),
                    error.error,
                    error.error_description
                )
            ));
        } catch (Exception error) {
            System.debug(LoggingLevel.DEBUG, error.getMessage());
            System.debug(LoggingLevel.INFO, error.getStackTraceString());

            RestContext.response.statuscode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'Internal Server Error',
                    null
                ),
                true
            ));
        }
    }

    private static String validateAuth(String customerId, Boolean isGetMethod) {
        if(String.isBlank(customerId)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'Bad Request', 'Customer must not be empty');
        }

        WebportalAPITokenAuthentication_v1.AccessTokenData accessTokenData =
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.Request,
                new Set<string> {
                    isGetMethod
                    ? 'urn:axa.partners.specific.visagateway.customers.read_only'
                    : 'urn:axa.partners.specific.visagateway.customers.write'
                }
            );
        WebportalAPITokenAuthentication_v1.ClientAccessConfiguration clientAccessConfig =
            WebportalAPITokenAuthentication_v1.getClientConfiguration(accessTokenData);
        WebportalAPITokenAuthentication_v1.validateClientAccess(clientAccessConfig, customerId, accessTokenData);

        return accessTokenData.aud;
    }

    private static Id validatePolicy() {
        String policieId = RestContext.request.requestURI.substringAfter('/policies/');
        if (String.isBlank(policieId)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'Bad Request', 'Policy must not be null');
        } else if (Id.valueOf(policieId).getSobjectType() != Schema.MN_Account_BIN__c.getSObjectType()){
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'Bad Request', 'Policy must be valid');
        }

        return Id.valueOf(policieId);
    }

    private static void validateRequiredFields(String policyRequestBody, Set<String> requiredFields) {
        String errorMessage = WebportalApiUtility_v1.validateJSONRequiredFields(policyRequestBody, requiredFields);
        if (String.isNotBlank(errorMessage)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'Bad Request',
                'Field ' + errorMessage + ' is required'
            );
        }
    }

    private static Account getCustomer(String customerIdentifier) {
        Account existingCustomer = WebportalApiUtility_v1.getUserByCustomerId(customerIdentifier);
        if (existingCustomer == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'Customer not found');
        }

        return existingCustomer;
    }

    private static String getDecryptedAndSanitizedBody(String clientId) {
        String requestBody = RestContext.request.requestBody.toString().trim();
        if (requestBody.contains('encrypted_data')) {
            requestBody = WebportalApiUtility_v1.decryptRequestBody(clientId, requestBody);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'Bad Request',
                'Body must be encrypted'
            );
        }
        requestBody = WebportalApiUtility_v1.parseJSONBodyRequest(requestBody);
        requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
        requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

        return requestBody;
    }
