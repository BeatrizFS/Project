                    JSONWebEncryption.JWK jwkKey = (JSONWebEncryption.JWK) JSON.deserialize( key.Private_RSA_Key__c, JSONWebEncryption.JWK.class );
                    jwe.setCEKAlgorithmKey( jwkKey );
                }

                EncryptedData encryptObj = (EncryptedData) JSON.deserializeStrict(RestContext.request.requestBody.toString(), EncryptedData.class);

                requestBody = jwe.decrypt( encryptObj.encrypted_data );
                requestBody = requestBody.trim();
