@HttpPatch
global static void doPatch() {
    RestContext.response.addHeader('Content-Type', 'application/json');

    List<String> segments = getResourceSegments(RESOURCE_PATH);

    if (segments.size() == 1 && String.isNotBlank(segments[0])) {
        handlePatch(segments[0]);
    } else {
        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'not_found',
            'Unknown resource path'
        );
    }
}


private static void handlePatch(String benefitPackageId) {
    try {
        WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
            RestContext.request,
            new Set<String>{
                'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                'urn:axa.partners.benefits_platform.write'
            }
        );

        String requestBody =
            RestContext.request.requestBody == null
                ? null
                : RestContext.request.requestBody.toString().trim();

        if (String.isBlank(requestBody)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Request body cannot be empty.'
            );
        }

        requestBody =
            WebportalApiUtility_v1.removeXMLInjections(requestBody);

        requestBody =
            WebportalApiUtility_v1.removeHtmlInjection(requestBody);

        BenefitPackage request =
            (BenefitPackage) JSON.deserializeStrict(
                requestBody,
                BenefitPackage.class
            );

        Map<String, Object> body =
            (Map<String, Object>) JSON.deserializeUntyped(requestBody);

        ServiceContract contract =
            getBenefitPackageForPatch(benefitPackageId);

        if (contract.Package_Status__c != PACKAGE_STATUS.get('DRAFT')) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit package cannot be updated because its current status is '
                    + contract.Package_Status__c
                    + '.'
            );
        }

        applyPatch(contract, request, body);

        update contract;

        RestContext.response.statusCode = 204;

    } catch (WebportalApiUtility_v1.RequestAPIException ex) {

        RestContext.response.statusCode = ex.status_code;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );

    } catch (JSONException ex) {

        RestContext.response.statusCode = 400;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '400',
                        'Bad Request',
                        'The input information received were not compliant with the endpoint specification.'
                    )
                )
            );

    } catch (DMLException ex) {

        System.debug(
            LoggingLevel.ERROR,
            'DMLException: ' + ex.getMessage()
        );

        System.debug(
            LoggingLevel.ERROR,
            'DMLException stack trace: ' + ex.getStackTraceString()
        );

        RestContext.response.statusCode = 500;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'database_internal_server_error',
                        'Error when try to update benefit package.'
                    )
                )
            );

    } catch (Exception ex) {

        System.debug(
            LoggingLevel.ERROR,
            'Exception type: ' + ex.getTypeName()
        );

        System.debug(
            LoggingLevel.ERROR,
            'Exception stack tracing: ' + ex.getStackTraceString()
        );

        RestContext.response.statusCode = 500;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'Unexpected error updating the benefit package.'
                    )
                )
            );
    }
}


private static ServiceContract getBenefitPackageForPatch(
    String benefitPackageId
) {
    List<ServiceContract> packages = [
        SELECT
            Id,
            Package_Status__c,
            Product_Reference__c,
            Product__c,
            Pricebook2Id,
            StartDate,
            EndDate,
            Term,
            Amount_of_Policies__c,
            Policy_Range_Start__c,
            Policy_Range_End__c,
            Legal_Consent_Code__c,
            Legal_Consent_Confirmed__c,
            Legal_Consent_Date__c,
            (
                SELECT
                    Id,
                    Benefit_Category__c
                FROM ContractLineItems
            )
        FROM ServiceContract
        WHERE Id = :benefitPackageId
        AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
        LIMIT 1
    ];

    if (packages.isEmpty()) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'Not Found',
            'The searched resource was not found.'
        );
    }

    return packages[0];
}


private static void applyPatch(
    ServiceContract contract,
    BenefitPackage request,
    Map<String, Object> body
) {
    /*
     * Campos presentes no body são atualizados.
     * Campos ausentes permanecem inalterados.
     */

    if (body.containsKey('product_reference')) {

        Product__c product =
            getProduct(request.product_reference);

        contract.Product_Reference__c =
            request.product_reference;

        contract.Product__c =
            product.Id;
    }

    if (body.containsKey('active_start_at')) {
        contract.StartDate =
            request.active_start_at;
    }

    if (body.containsKey('active_end_at')) {
        contract.EndDate =
            request.active_end_at;
    }

    if (
        body.containsKey('active_start_at') ||
        body.containsKey('active_end_at')
    ) {
        validateDates(
            contract.StartDate,
            contract.EndDate
        );

        contract.Term =
            calculateWholeMonthTerm(
                contract.StartDate,
                contract.EndDate
            );
    }

    if (body.containsKey('amount_of_policies')) {

        if (
            request.amount_of_policies == null ||
            request.amount_of_policies < 1
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'amount_of_policies must be a positive integer.'
            );
        }

        contract.Amount_of_Policies__c =
            request.amount_of_policies;
    }

    if (body.containsKey('affected_policy_range')) {

        if (request.affected_policy_range == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range cannot be null.'
            );
        }

        if (
            String.isBlank(
                request.affected_policy_range
                    .external_number_start_at
            )
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range.external_number_start_at is required.'
            );
        }

        if (
            String.isBlank(
                request.affected_policy_range
                    .external_number_end_at
            )
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range.external_number_end_at is required.'
            );
        }

        contract.Policy_Range_Start__c =
            request.affected_policy_range
                .external_number_start_at;

        contract.Policy_Range_End__c =
            request.affected_policy_range
                .external_number_end_at;
    }

    if (body.containsKey('legal_consents')) {
        populateLegalConsents(contract, request);
    }

    /*
     * As coleções são tratadas como replace.
     *
     * Se somente core_benefits vier:
     *   Core é substituído
     *   Optional permanece
     *
     * Se somente optional_benefits vier:
     *   Optional é substituído
     *   Core permanece
     *
     * Se ambas vierem:
     *   ambas são substituídas
     *
     * Se nenhuma vier:
     *   nenhuma linha é alterada
     */
    if (
        body.containsKey('core_benefits') ||
        body.containsKey('optional_benefits')
    ) {
        replaceBenefitLines(
            contract,
            request,
            body
        );
    }
}


private static void replaceBenefitLines(
    ServiceContract contract,
    BenefitPackage request,
    Map<String, Object> body
) {
    Boolean replaceCore =
        body.containsKey('core_benefits');

    Boolean replaceOptional =
        body.containsKey('optional_benefits');

    /*
     * Se uma coleção foi enviada, ela não pode ser vazia.
     */
    if (replaceCore) {

        if (
            request.core_benefits == null ||
            request.core_benefits.isEmpty()
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'core_benefits must contain at least one benefit.'
            );
        }

        if (request.core_benefits.size() > 100) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'core_benefits cannot contain more than 100 benefits.'
            );
        }
    }

    if (replaceOptional) {

        if (
            request.optional_benefits == null ||
            request.optional_benefits.isEmpty()
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'optional_benefits must contain at least one benefit.'
            );
        }

        if (request.optional_benefits.size() > 100) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'optional_benefits cannot contain more than 100 benefits.'
            );
        }
    }

    /*
     * Resolve apenas os benefícios que vieram no PATCH.
     */
    Map<String, Benefit__c> benefitsByReference =
        new Map<String, Benefit__c>();

    Set<String> requestedBenefitReferences =
        new Set<String>();

    if (replaceCore) {
        for (CoreBenefit benefit : request.core_benefits) {
            requestedBenefitReferences.add(
                benefit.benefit_id
            );
        }
    }

    if (replaceOptional) {
        for (OptionalBenefit benefit : request.optional_benefits) {
            requestedBenefitReferences.add(
                benefit.benefit_id
            );
        }
    }

    List<Benefit__c> benefits = [
        SELECT
            Id,
            Visa_External_Reference__c,
            Name,
            Benefit_Description__c
        FROM Benefit__c
        WHERE Visa_External_Reference__c
            IN :requestedBenefitReferences
    ];

    for (Benefit__c benefit : benefits) {
        benefitsByReference.put(
            benefit.Visa_External_Reference__c,
            benefit
        );
    }

    for (String reference : requestedBenefitReferences) {
        if (!benefitsByReference.containsKey(reference)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit ' + reference
                    + ' was not found in the catalogue.'
            );
        }
    }

    /*
     * Resolve PricebookEntry somente dos benefícios enviados.
     */
    Map<String, PricebookEntry> pricebookEntriesByBenefit =
        getPricebookEntriesByBenefitReference(
            benefitsByReference,
            'USD'
        );

    /*
     * Delete somente as categorias que foram enviadas.
     */
    List<ContractLineItem> linesToDelete =
        new List<ContractLineItem>();

    for (ContractLineItem lineItem :
        contract.ContractLineItems
    ) {
        if (
            replaceCore &&
            lineItem.Benefit_Category__c == 'Core'
        ) {
            linesToDelete.add(lineItem);
        }

        if (
            replaceOptional &&
            lineItem.Benefit_Category__c == 'Optional'
        ) {
            linesToDelete.add(lineItem);
        }
    }

    if (!linesToDelete.isEmpty()) {
        delete linesToDelete;
    }

    /*
     * Cria somente as categorias presentes no PATCH.
     */
    List<ContractLineItem> newLineItems =
        new List<ContractLineItem>();

    Integer quantity =
        contract.Amount_of_Policies__c == null
            ? 0
            : Integer.valueOf(
                contract.Amount_of_Policies__c
            );

    if (replaceCore) {

        for (CoreBenefit coreBenefit :
            request.core_benefits
        ) {
            newLineItems.add(
                buildContractLineItem(
                    contract.Id,
                    quantity,
                    contract.StartDate,
                    contract.EndDate,
                    benefitsByReference.get(
                        coreBenefit.benefit_id
                    ),
                    pricebookEntriesByBenefit.get(
                        coreBenefit.benefit_id
                    ),
                    'Core',
                    0
                )
            );
        }
    }

    if (replaceOptional) {

        for (OptionalBenefit optionalBenefit :
            request.optional_benefits
        ) {
            PricebookEntry pricebookEntry =
                pricebookEntriesByBenefit.get(
                    optionalBenefit.benefit_id
                );

            newLineItems.add(
                buildContractLineItem(
                    contract.Id,
                    quantity,
                    contract.StartDate,
                    contract.EndDate,
                    benefitsByReference.get(
                        optionalBenefit.benefit_id
                    ),
                    pricebookEntry,
                    'Optional',
                    pricebookEntry.UnitPrice
                )
            );
        }
    }

    if (!newLineItems.isEmpty()) {
        insert newLineItems;
    }
}


private static void validateDates(
    Date startDate,
    Date endDate
) {
    if (startDate == null || endDate == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_start_at and active_end_at are required.'
        );
    }

    if (endDate <= startDate) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_end_at must be greater than active_start_at.'
        );
    }
}
