private static void validateBenefits(
    Integer size,
    String fieldName,
    Boolean required
) {
    if (required && (size == null || size == 0)) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            fieldName + ' must contain at least one item.'
        );
    }
}
